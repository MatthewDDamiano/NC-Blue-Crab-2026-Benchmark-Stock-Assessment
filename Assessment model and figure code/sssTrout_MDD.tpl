  init_matrix   DmGrowthParaData(1,lL1,1,lL2) // initial value/lo/up/phase/sd/lambda/likelihood_flag            
  !! if(DiGrowthMatrixFlag>0) ICHECKPIR(DmGrowthParaData);                           

  vector   DvGrowthParaIni(1,DiGrowthParaNum)
  vector   DvGrowthParaLo(1,DiGrowthParaNum)
