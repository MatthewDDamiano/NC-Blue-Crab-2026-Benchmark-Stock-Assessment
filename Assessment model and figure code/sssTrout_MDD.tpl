  /////////// index selectivity
  int        DiIndexSelParaNum                          // cumulative number of paras for all blocks
  ivector    DivIndexSelParaIndex(1,DiIndexSelBlockNum) // cumulative number of paras before starting the next block
                                                                 
 LOCAL_CALCS  
    DiIndexSelParaNum=0;
    for (i=1;i<=DiIndexSelBlockNum;i++)
    {
       DivIndexSelParaIndex(i)=DiIndexSelParaNum;
       switch(DivIndexSelFlag(i))
       {
          case 1:
                DiIndexSelParaNum+=DiSizeBinNum;
                break;
          case 2:
                DiIndexSelParaNum+=2;
                break;
          case 3:
                DiIndexSelParaNum+=4;
                break;
          case 4:
                DiIndexSelParaNum+=4;
                break;
          case 5:
                DiIndexSelParaNum+=6;
                break;
       }
    }
    #if Debug_Status
        ICHECKIAA(DiIndexSelParaNum);
        ICHECKIAA(DivIndexSelParaIndex);
    #endif
 END_CALCS

  init_matrix DmIndexSelParaData(1,DiIndexSelParaNum,1,8) 
  !! ICHECKPIR(DmIndexSelParaData);
  
  vector   DvIndexSelParaIni(1,DiIndexSelParaNum)
  vector   DvIndexSelParaLo(1,DiIndexSelParaNum)
  vector   DvIndexSelParaHi(1,DiIndexSelParaNum)
  ivector  DivIndexSelParaPh(1,DiIndexSelParaNum) 
  vector   DvIndexSelParaMean(1,DiIndexSelParaNum)
  vector   DvIndexSelParaSigma2(1,DiIndexSelParaNum) 
  vector   DvIndexSelParaSigma(1,DiIndexSelParaNum)
  vector   DvIndexSelParaLambda(1,DiIndexSelParaNum) 
  ivector  DivIndexSelParaLikelihoodFlag(1,DiIndexSelParaNum)  

 LOCAL_CALCS    
     for(i=1;i<=DiIndexSelParaNum;i++)
     {                                  
          DvIndexSelParaIni(i)= DmIndexSelParaData(i,1);
          DvIndexSelParaLo(i) = DmIndexSelParaData(i,2);
          DvIndexSelParaHi(i) = DmIndexSelParaData(i,3);
          DivIndexSelParaPh(i) = DmIndexSelParaData(i,4) > MINPOSITIVE? int(DmIndexSelParaData(i,4)+0.01):int(DmIndexSelParaData(i,4)-0.01);
          DvIndexSelParaMean(i)= DmIndexSelParaData(i,5);
          if(DmIndexSelParaData(i,6)> MINPOSITIVE)
                DvIndexSelParaSigma2(i)=DmIndexSelParaData(i,6)*DmIndexSelParaData(i,6);
          else
                DvIndexSelParaSigma2(i)=SIGMA2FILL;
          DvIndexSelParaSigma(i)=sqrt(DvIndexSelParaSigma2(i));
          DvIndexSelParaLambda(i)=DmIndexSelParaData(i,7); 
          DivIndexSelParaLikelihoodFlag(i)=int(DmIndexSelParaData(i,8)+0.01);
     }
     
     for(i=1;i<=DiIndexNum;i++)
     {
         if(DivRecruitIndexFlag(i)>0)   //special index skips selectivity, so set phase=-1
         {
            ii=DimIndexSelBlockFlag(1,i+1);      //block; use block# for yr1 becaue a single blk is used for special index
            iL1=DivIndexSelParaIndex(ii)+1;        //cumulative number of paras before starting a blk
            if(ii<DiIndexSelBlockNum)
                iL2=DivIndexSelParaIndex(ii+1);
            else
                iL2=DiIndexSelParaNum;
            DivIndexSelParaPh(iL1,iL2)=-1;
         }
     }

   #if Debug_Status
      ICHECKPIR(DvIndexSelParaIni);
      ICHECKPIR(DvIndexSelParaLo);
      ICHECKPIR(DvIndexSelParaHi);
      ICHECKPIR(DivIndexSelParaPh);
      ICHECKPIR(DvIndexSelParaMean);
      ICHECKPIR(DvIndexSelParaSigma);
      ICHECKPIR(DvIndexSelParaLambda);
      ICHECKPIR(DivIndexSelParaLikelihoodFlag);
   #endif
   cout << "Survey sel pars OK" << endl; 
 END_CALCS

  /////// index Q 
  init_matrix  DmIndexQParaData(1,DiIndexQBlockNum,1,8) 
  !!ICHECKPIR(DmIndexQParaData)

  vector   DvIndexQParaIni(1,DiIndexQBlockNum) 
