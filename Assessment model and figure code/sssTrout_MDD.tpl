  /////Initial
  !!1L1=DiFleetNum*DiSeasonNum;
  init_matrix      DmInitFParaData(1,1L1,1,8)
  !!ICHECKPIR(DmInitFParaData);
  
  int	     DiInitFParaNum
  !!DiInitFParaNum=DiFleetNum*DiSeasonNum;
  
  vector           DvInitFParaIni(1,1L1)
  vector           DvInitFParaLo(1,1L1)
  vector           DvInitFParaHi(1,1L1)
  ivector          DivInitFParaPh(1,1L1)
  vector           DvInitFParaMean(1,1L1)
  vector           DvInitFParaSigma2(1,1L1)
  vector           DvInitFParaSigma(1,1L1)
  vector           DvInitFParaLambda(1,1L1)
  ivector          DivInitFParaLikelihoodFlag(1,1L1)           
  
 LOCAL_CALCS
   for(i=1;i<=DiFleetNum;i++)
   {
    for(k=1;k<=DiSeasonNum;k++)
	{ 
	
	 iL1=(i-1)*DiSeasonNum+k;
	 
	 if(DmInitFParaData(iL1)>0.0)
	   DvInitFParaIni(iL1)=log(DmInitFParaData(iL1,1);
	 else
	   DvInitFParaIni(iL1)=log(0.27/4.0);
	   
	 if(DmInitFParaData(iL1,2)>0.0)
	   DvInitFParaLo(iL1)=log(DmInitFParaData(iL1,2));
	 else
	   DvInitFParaLo(iL1)=-25.0;
	 
	 if(DmInitFParaData(iL1,3)>0.0)
	   DvInitFParaHi(iL1)=log(DmInitFParaData(iL1,3));
	 else
	   DvInitFParaHi=log(DnFmax);
	 
	 if(DimFleetFirstYear(i,k)==0)
	 {
	   DivInitFParaPh(iL1)=-2;
	 }
	 else
	   DivInitFParaPh(iL1)=DminitFParaData(iL1,4)>0.0 ? int(DmInitFParaData(iL1,4)+0.01): int(DmInitFParaData(iL1,4)-0.01);
	 
       DvInitFParaMean(iL1)=log(DmInitFParaData(iL1,5);
	   DvInitFParaSigma2(iL1)=DmInitFParaData(iL1,6)*DmInitFParaData(iL1,6);
	   DvInitFParaSigma(iL1)=sqrt(DvFishingMortalityParaSigma2(iL1));
       DvInitFParaLambda(iL1)=DmFishingMortalityParaData(iL2,7);
       DivInitFParaLikelihoodFlag(iL1)=int(DmFishingMortalityParaData(iL2,8)+0.01); 
	}
   }
  
    #if Debug_Status
      ICHECKPIR(DvInitFParaIni);
      ICHECKPIR(DvInitFParaLo);
      ICHECKPIR(DvInitFParaHi);
      ICHECKPIR(DivInitFParaPh);
      ICHECKPIR(DvInitFParaMean);
      ICHECKPIR(DvInitFParaSigma);
      ICHECKPIR(DvInitFParaLambda);
      ICHECKPIR(DivInitFParaLikelihoodFlag);
  #endif
  cout << DmInitFParaData << endl;
  cout << "Initial F pars OK" << endl;

  /////F
  !!lL1=DiFleetNum*DiSeasonNum;
  init_matrix      DmFishingMortalityParaData(1,lL1,1,8)  
  !!ICHECKPIR(DmFishingMortalityParaData);
  
  int        DiFishingMortalityParaNum
  !!DiFishingMortalityParaNum=DiFleetNum*DiCalYearNum*DiSeasonNum;

  !!lL1=DiCalBeginYear;
  !!lL2=DiCalBeginYear+DiFishingMortalityParaNum-1;

  vector           DvFishingMortalityParaIni(lL1,lL2)
  vector           DvFishingMortalityParaLo(lL1,lL2)
  vector           DvFishingMortalityParaHi(lL1,lL2)
  ivector          DivFishingMortalityParaPh(lL1,lL2)
  vector           DvFishingMortalityParaMean(lL1,lL2)
  vector           DvFishingMortalityParaSigma2(lL1,lL2)
  vector           DvFishingMortalityParaSigma(lL1,lL2)
  vector           DvFishingMortalityParaLambda(lL1,lL2)
  ivector          DivFishingMortalityParaLikelihoodFlag(lL1,lL2)

 LOCAL_CALCS
 
 for(i=1;i<=DiFleetNum;i++)
   {  
      for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
      {
          for(k=1;k<=DiSeasonNum;k++)
          {
               iL1=(i-1)*(DiCalEndYear-DiCalBeginYear+1)*DiSeasonNum + (j-DiCalBeginYear)*DiSeasonNum +k; // in y1s1 = 1, in y1s2 = 2
               iL2=(i-1)*DiSeasonNum +k;
               lL2=(j-DiCalBeginYear)*DiSeasonNum+k;
               if(DimFleetFZeroIndex(i,lL2)!=0)
               {
                     DvFishingMortalityParaIni(iL1)=0.0;                     //DmFLogDevs_Ini(i,1);
                     DvFishingMortalityParaLo(iL1)=log(MINPOSITIVE);         //DmFLogDevs_Ini(i,2);
                     DvFishingMortalityParaHi(iL1)=log(DnFmax/MINPOSITIVE);  //DmFLogDevs_Ini(i,3);
                    // DivFLogDevsPh(iL1)=DmFLogDevs_Ini(iL2,4)>MINPOSITIVE ? int(DmFLogDevs_Ini(iL2,4)+0.01) : int(DmFLogDevs_Ini(iL2,4)-0.01) ;
                     DivFishingMortalityParaPh(iL1)=1;
               }
               else
               {
                    DvFishingMortalityParaIni(iL1)=log(MINPOSITIVE);
                    DvFishingMortalityParaLo(iL1)=log(MINPOSITIVE);
                    DvFishingMortalityParaHi(iL1)=log(DnFmax/MINPOSITIVE);
                    DivFishingMortalityParaPh(iL1)=-2;
               }
			   DvFishingMortalityParaMean(iL1)= DmFishingMortalityParaData(iL2,5);
               if(DmFishingMortalityParaData(iL2,6)>MINPOSITIVE)
                        DvFishingMortalityParaSigma2(iL1)=DmFishingMortalityParaData(iL2,6)*DmFishingMortalityParaData(iL2,6);
               else
                        DvFishingMortalityParaSigma2(iL1)=SIGMA2FILL; 

               DvFishingMortalityParaSigma(iL1)=sqrt(DvFishingMortalityParaSigma2(iL1));
               DvFishingMortalityParaLambda(iL1)=DmFishingMortalityParaData(iL2,7);
               DivFishingMortalityParaLikelihoodFlag(iL1)=int(DmFishingMortalityParaData(iL2,8)+0.01); 
          }

       }   
    }
   
   lL1=DiFleetNum*(DiCalEndYear-DiCalBeginYear+1)*DiSeasonNum;
   for(i=1;i<=DiFleetNum;i++)
   {
             for(k=1;k<=DiSeasonNum;k++)
             {
                j= DimFleetFirstYear(i,k);//j==0
                if(j==0)
                 continue;
                 //  k= DivFleetFirstSeason(i);
                iL1=(i-1)*(DiCalEndYear-DiCalBeginYear+1)*DiSeasonNum + (j-DiCalBeginYear)*DiSeasonNum +k;
				iL2=(i-1)*DiSeasonNum +k;
                if( iL1>=1 && iL1<=lL1)
                {
                    DvFishingMortalityParaIni(iL1)=0.0;
                    DvFishingMortalityParaLo(iL1)=log(MINPOSITIVE);
                    DvFishingMortalityParaHi(iL1)=log(DnFmax/MINPOSITIVE);
                    DivFishingMortalityParaPh(iL1)=-2;
                }  
				DvFishingMortalityParaMean(iL1)= DmFishingMortalityParaData(iL2,5);
                if(DmFishingMortalityParaData(iL2,6)>MINPOSITIVE)
                        DvFishingMortalityParaSigma2(iL1)=DmFishingMortalityParaData(iL2,6)*DmFishingMortalityParaData(iL2,6);
                else
                        DvFishingMortalityParaSigma2(iL1)=SIGMA2FILL; 

                DvFishingMortalityParaSigma(iL1)=sqrt(DvFishingMortalityParaSigma2(iL1));
                DvFishingMortalityParaLambda(iL1)=DmFishingMortalityParaData(iL2,7);
                DivFishingMortalityParaLikelihoodFlag(iL1)=int(DmFishingMortalityParaData(iL2,8)+0.01); 
             }
   }     
   for(i=1;i<=DiFleetNum;i++)
   {        
      for(k=1;k<=DiSeasonNum;k++)
      {
          for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
          {
               iL1=(i-1)*DiSeasonNum*DiCalYearNum+(k-1)*DiCalYearNum+j; // y1s1 this = j = 1, y1s2 = # of years +1
               iL2=(i-1)*DiSeasonNum+k;
               lL2=(k-1)*DiCalYearNum+j;   // zero catch fleet
              
               DvFishingMortalityParaIni(iL1)= DmFishingMortalityParaData(iL2,1);
               DvFishingMortalityParaLo(iL1) = DmFishingMortalityParaData(iL2,2);
               DvFishingMortalityParaHi(iL1) = DmFishingMortalityParaData(iL2,3);
               if(DimFleetFZeroIndex(i,lL2)>0)   //zero catch fleet has no F to estimate, set F=0
               {
                    DivFishingMortalityParaPh(iL1)=DmFishingMortalityParaData(iL2,4)>MINPOSITIVE ? int(DmFishingMortalityParaData(iL2,4)+0.01) : int(DmFishingMortalityParaData(iL2,4)-0.01);
               }
               else
               {                   
                    DivFishingMortalityParaPh(iL1)=-1;                  
               }
               DvFishingMortalityParaMean(iL1)= DmFishingMortalityParaData(iL2,5);
               if(DmFishingMortalityParaData(iL2,6)>MINPOSITIVE)
                        DvFishingMortalityParaSigma2(iL1)=DmFishingMortalityParaData(iL2,6)*DmFishingMortalityParaData(iL2,6);
               else
                        DvFishingMortalityParaSigma2(iL1)=SIGMA2FILL; 

               DvFishingMortalityParaSigma(iL1)=sqrt(DvFishingMortalityParaSigma2(iL1));
               DvFishingMortalityParaLambda(iL1)=DmFishingMortalityParaData(iL2,7);
               DivFishingMortalityParaLikelihoodFlag(iL1)=int(DmFishingMortalityParaData(iL2,8)+0.01); 
          }
       }   
    }
  
  #if Debug_Status
      ICHECKPIR(DvFishingMortalityParaIni);
      ICHECKPIR(DvFishingMortalityParaLo);
      ICHECKPIR(DvFishingMortalityParaHi);
      ICHECKPIR(DivFishingMortalityParaPh);
      ICHECKPIR(DvFishingMortalityParaMean);
      ICHECKPIR(DvFishingMortalityParaSigma);
      ICHECKPIR(DvFishingMortalityParaLambda);
      ICHECKPIR(DivFishingMortalityParaLikelihoodFlag);
  #endif
  cout << DmFishingMortalityParaData << endl;
  cout << "F pars OK" << endl;
 END_CALCS

 ///////////growth transition matrix
  int        DiGrowthParaNum                      // cumulative number of paras for all blocks

 LOCAL_CALCS
   if(DiGrowthMatrixFlag==0)
   {
     DiGrowthParaNum=5;  // 5 parameters for place holder here
   }
   if(DiGrowthMatrixFlag==1)
   {
      DiGrowthParaNum= 5 * DiGrowthMatrixBlockNum; // 5 parameters Linf,V,LSD,VSD,Rho(Linf,V); L(t)=L(~)+(L(1)-L(~))*e^(-V(t-t(1)))
   }
