                DvIndexQParaSigma2(i) = DmIndexQParaData(i,6)*DmIndexQParaData(i,6);
          else
                DvIndexQParaSigma2(i) = SIGMA2FILL;        
          DvIndexQParaSigma(i)= sqrt(DvIndexQParaSigma2(i));
