          DvGrowthParaIni(i)= DmGrowthParaData(i,1);
          DvGrowthParaLo(i) = DmGrowthParaData(i,2);
          DvGrowthParaHi(i) = DmGrowthParaData(i,3);
          DivGrowthParaPh(i) = DmGrowthParaData(i,4) > MINPOSITIVE? int(DmGrowthParaData(i,4)+0.01):int(DmGrowthParaData(i,4)-0.01);
          DvGrowthParaMean(i)= DmGrowthParaData(i,5);
          if(DmGrowthParaData(i,6)> MINPOSITIVE)
                DvGrowthParaSigma2(i)=DmGrowthParaData(i,6)*DmGrowthParaData(i,6);
          else
                DvGrowthParaSigma2(i)=SIGMA2FILL;

          DvGrowthParaSigma(i)=sqrt(DvGrowthParaSigma2(i));
          DvGrowthParaLambda(i)=DmGrowthParaData(i,7); 
          DivGrowthParaLikelihoodFlag(i)=int(DmGrowthParaData(i,8)+0.01);
