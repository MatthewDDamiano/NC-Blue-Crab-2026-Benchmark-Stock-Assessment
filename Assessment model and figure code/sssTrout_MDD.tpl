      ICHECKPIR(DvGrowthParaHi);
      ICHECKPIR(DivGrowthParaPh);
      ICHECKPIR(DvGrowthParaMean);
      ICHECKPIR(DvGrowthParaSigma);
      ICHECKPIR(DvGrowthParaLambda);
      ICHECKPIR(DivGrowthParaLikelihoodFlag);
   #endif
   }
   cout << DmGrowthParaData << endl;
   cout << "Growth pars OK" << endl;
 END_CALCS

