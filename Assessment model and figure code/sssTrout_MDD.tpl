  ///////////////////////////////////////////////////////////////////// DEFINE FUNCTIONS
  ///// calculate the factorial terms (in multinomial distribution)
  double CalLogFactorial(int iFactor) 
   {
      int    i;
      double dR;
      dR=0.0;
      if(iFactor>=2)
      {
        for(i=2;i<=iFactor;i++)
        {
          dR+=log(double(i));
        }
      }
      return dR;
   }

  /////// calculate -Ln(L) for propotions (composition data)
  dvariable CalLikelihoodPropVar(const dvector dvrObs,const dvar_vector &dvvPred, const int iESS, const int iB, const int iE,int iModel)
  {
        dvariable dvR;
        dvariable dvChi;
        dvariable dvVariance;
        dvariable dvResids;
        int iNBN;
        double dTau; 
        int k;
        iNBN=iE-iB+1;
        dvR.initialize();
        dTau=1.0/iESS;

        switch(iModel)
        {
          case 1:        //multinomial distribution
                for(k=iB;k<=iE;k++)
                {       
                    //dvR -=iESS*dvrObs(k)*log(dvvPred(k)+ MINPOSITIVE);   //kernel of -Ln(L)
                    dvR +=CalLogFactorial(int(iESS*dvrObs(k)))-iESS*dvrObs(k)*log(dvvPred(k)+ MINPOSITIVE);
                }
                dvR -= CalLogFactorial(iESS);
                break;
          case 2:        //robust normal distribution
                for(k=iB;k<=iE;k++)
                {
                      dvChi=dvvPred(k)*(1.0-dvvPred(k));
		                  dvVariance=(dvChi+0.1/iNBN)*dTau*dTau;
                      dvResids=dvrObs(k)-dvvPred(k);

                      dvR +=log(PI2*dvVariance)*0.5-log(mfexp(-0.5*square(dvResids)/dvVariance)+0.01);
                }            
                break;
          default:
                dvR=0.0;
                break;
        }
        return dvR;  
  } 
   
  //// calculate -Ln(L)
  dvariable CalLikelihoodVar(double obs,double dSigma2, const prevariable &pred, const int iModel)
  {
       dvariable  dvarR;
       dvariable  dvarTemp;
       double     dR;           //constant part of the -Ln(L)
       dR=0.0;
       dvarR=0.0;

       switch(iModel)
       { 
          case 1:                     //robust normal distribution
                dR=0.5*log(PI2);
                if(obs>0.0 && pred>0.0)
                     dvarR=-log(mfexp(-square(log(obs)-log(pred))/(2*dSigma2))+0.01)+log(dSigma2)*0.5+dR;
                else
                     dvarR=0.0;
                break;
          case 2:                   // student t-distribution fattail likelihood
                dR=log(1.32934/sqrt(4.0*PI));
                if(obs>0.0 && pred>0.0)
                     dvarR= 2.5*log(1.0+square(log(obs)-log(pred))/(4.0*dSigma2))+dR;
                else
                     dvarR=0.0;
                break;        
          case 3:                  //log-normal distribution with obs term 
                dR=0.5*log(PI2)+log(obs); 
                if(obs>0.0 && pred>0.0)
                     dvarR=0.5*square(log(obs)-log(pred))/dSigma2+log(dSigma2)*0.5+dR;
                else
                     dvarR=0.0;
                break;
          case 4:                  //log-normal distribution without obs term
                dR=0.5*log(PI2);
                if(obs>0.0 && pred>0.0)
                      dvarR=0.5*square(log(obs)-log(pred))/dSigma2+log(dSigma2)*0.5+dR;
                else
                      dvarR=0.0;
                break;
          case 5:                //normal distribution
                dR=0.5*log(PI2);      
                dvarR=0.5*square(obs-pred)/dSigma2+log(dSigma2)*0.5+dR;
                break;
          case 6:                //Cauchy distribution
                dR=log(0.675*PI);
                dvarTemp=0.675*sqrt(dSigma2);
                dvarR=log(dvarTemp*(1.0+square((obs-pred)/dvarTemp)))+dR;  
                break;
          case 7:                // Uniform distribution dSigma2=(b-a)^2/12 -> f(x)=1/(b-a)=sqrt(1/(12*dSigma2)) 
                dR=0.0;
                dvarR=0.5*log(12*dSigma2)+dR;
                break;
          default:
                dvarR=0.0;
                break;
       }
      return dvarR;
  }
    
    //// Calculate -Ln(L) for process errors (normal deviation terms) such as for F, Recruit and N
    dvariable CalLikelihoodDev(const prevariable &dSigma2, const prevariable &pred)
    {
      dvariable dvarR;
      double     dR;           //constant part of the -Ln(L)
      dR=0.0;
      dvarR=0.0;
 
      dR=0.5*log(PI2);
      dvarR= 0.5*square(pred)/dSigma2+log(dSigma2)*0.5+dR;          
      
      return dvarR;
    }

   //// calculate -Ln(L) for environmental variables fit to devation (normal deviation)
   dvariable CalLikelihoodEnv(const prevariable &obs,double dSigma2, const prevariable &pred)
   {
      dvariable dvarR;
      double     dR;           //constant part of the -Ln(L)
      dR=0.0;
      dvarR=0.0;

      dR=0.5*log(PI2);      
      dvarR=0.5*square(obs-pred)/dSigma2+log(dSigma2)*0.5+dR;

      return dvarR;
   }

   //// calculate SR relationship
    dvariable CalStockRecruitment(const prevariable &dvSSB, const prevariable &dvAlpha, const prevariable &dvBeta, const int iModel)
    {
      dvariable dvR;
      dvR=0.0;
      switch(iModel)
        {
          case 1:          //annual average R independent of spawner
               dvR=dvAlpha;
               break;
          case 2:          //Beverton-Holt
               dvR=dvAlpha*dvSSB/(1+dvBeta*dvSSB);
               break;
          case 3:          //Ricker
               dvR=dvAlpha*dvSSB*mfexp(-dvBeta*dvSSB);
               break;
           default:
               break;
        }
        return dvR;  
    }

  //// calculate growth matrix
  dvariable GrowthVariance(const prevariable &dvDeltaL,const prevariable &dvDeltaLVar, const double dL)   
  {
      dvariable dvTemp;
      dvTemp=1.0/sqrt(PI2*dvDeltaLVar)*mfexp(-(dL-dvDeltaL)*(dL-dvDeltaL)*0.5/dvDeltaLVar); //normal pdf with mean dvDeltaL and var dvDeltaLVar for a given variabl dL
      return dvTemp;
  }
  
  // numerically approximate the integral by dividing the pdf into small (panels) and summing up the area of all panels between xMin and xMax
  // Simpson's rule using quadratic terms
  dvariable Integrate(const prevariable &dvDeltaL,const prevariable &dvDeltaLVar,double xMin,double xMax,int Panels)
  {
    dvariable result = 0.0;
    int i;
    double interval = (xMax-xMin)/Panels;//length of a bin
    if(Panels%2!=0)
    {
            cerr<<"Integer type Panels must be even to use Simpson's rule."<<endl;
            abort();
    }
    else
    {
            double xIterator = xMin;
            double xIt2;
            for( i=0;i<=Panels;i++)
            {
                if(i%2 == 0)
                {
                    result += 2*GrowthVariance(dvDeltaL,dvDeltaLVar,xIterator);
                }
                else
                {
                    result += 4*GrowthVariance(dvDeltaL,dvDeltaLVar,xIterator);
                }
                xIterator += interval;
                if(dvDeltaLVar<0.001)
                {
                    xIt2=xIterator+interval;
                    if(xIterator<dvDeltaL && xIt2>dvDeltaL)
                            xIterator=value(dvDeltaL);
                }
            }
            result -= (GrowthVariance(dvDeltaL,dvDeltaLVar,xMin)+GrowthVariance(dvDeltaL,dvDeltaLVar,xMax));
            result *= interval/3;            
    }
    return result;
  }
  
