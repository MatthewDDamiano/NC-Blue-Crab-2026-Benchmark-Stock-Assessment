          DivIndexQParaPh(i)  = DmIndexQParaData(i,4)>MINPOSITIVE ? int(DmIndexQParaData(i,4)+0.01) :int(DmIndexQParaData(i,4)-0.01);
          DvIndexQParaMean(i) = DmIndexQParaData(i,5);
