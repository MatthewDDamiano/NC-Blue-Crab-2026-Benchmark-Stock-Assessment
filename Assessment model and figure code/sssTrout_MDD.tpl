///////////////////////////////////////////////////////////// DEFINE FUNCTIONS
//// Double normal selectivity based on SS3
FUNCTION dvariable DoubleNormalSel(const dvar_vector &dvvP,int iStartSelBin,int iEndSelBin, int iCurrentBin,double dBinwidth,int iMode)
    dvariable  dvvSel;
    dvariable  dvPeak1;
    dvariable  dvPeak2;
    dvariable  dvUpSelx;
    dvariable  dvDownSelx;
    double     dStartBinSize;
    double     dMaxBinSize;
    double     dMidBinSize;

    dStartBinSize=(DvSizeBinData(iStartSelBin)+DvSizeBinData(iStartSelBin-1))*0.5;
    dMaxBinSize=(DvSizeBinData(iEndSelBin)+DvSizeBinData(iEndSelBin-1))*0.5;
    dMidBinSize=(DvSizeBinData(iCurrentBin)+DvSizeBinData(iCurrentBin-1))*0.5;

    dvPeak1=dvvP(1);
    dvPeak2=dvPeak1+dBinwidth+(0.99*dMaxBinSize-dvPeak1-dBinwidth)/(1.0+mfexp(-dvvP(2)));
    dvUpSelx=mfexp(dvvP(3));
    dvDownSelx=mfexp(dvvP(4));
  
    if(iMode==0)
    {
        if(dMidBinSize<dvPeak1)
        {
           dvvSel=mfexp(-square(dMidBinSize-dvPeak1)/dvUpSelx);
        }
        else if(dMidBinSize<dvPeak2)
        {
             dvvSel=1.0;
        }
        else
        {
             dvvSel=mfexp(-square(dMidBinSize-dvPeak2)/dvDownSelx);
        }      
    }
    else if(iMode==1)
    {
       dvariable  dvFinal;
       dvariable  dvInit;
       int        j1;
       dvariable  dvPoint1;
       dvariable  dvPoint2;
       dvariable  dvT1min;
       dvariable  dvT2min;
       dvariable  dvJoin1;
       dvariable  dvJoin2;
       dvariable  dvAsc;
       dvariable  dvAsc_scale;
       dvariable  dvDsc;
       dvariable  dvDsc_scale;
       
       dvInit=dvvP(5);
       dvFinal=dvvP(6);

       if(dvInit< -1000.0)
                  j1=-1001-int(value(dvInit));
            else
                  j1=-1;
       
        dvAsc=mfexp(-(square(dMidBinSize-dvPeak1)/dvUpSelx));
        dvDsc=mfexp(-(square(dMidBinSize-dvPeak2)/dvDownSelx));
        dvJoin1=1.0/(1.0+mfexp(-(20.0*(dMidBinSize-dvPeak1)/(1.0+fabs(dMidBinSize-dvPeak1)))));  
        dvJoin2=1.0/(1.0+mfexp(-(20.0*(dMidBinSize-dvPeak2)/(1.0+fabs(dMidBinSize-dvPeak2)))));

        if(dvInit> -999.0)
        {           
                  dvPoint1=1.0/(1.0+mfexp(-dvInit));                
                  dvT1min=mfexp(-(square(dStartBinSize-dvPeak1)/dvUpSelx));
                  dvAsc_scale=dvPoint1+(1.0-dvPoint1)*(dvAsc-dvT1min)/(1.0-dvT1min);
        }           
        else
        {
                  dvAsc_scale=dvAsc;
        }
            
        if(dvFinal> -999.0)
        {
                  dvPoint2=1.0/(1.0+mfexp(-dvFinal));
                  dvT2min=mfexp(-(square(dMaxBinSize-dvPeak2)/dvDownSelx));
                  dvDsc_scale=1.0+(dvPoint2-1.0)*(dvDsc-1.0)/(dvT2min-1.0);
        }
        else
        {
                  dvDsc_scale=dvDsc;
        }

        if(iCurrentBin>j1)
        {
                  dvvSel=dvAsc_scale*(1.0-dvJoin1)+dvJoin1*(1.0-dvJoin2+dvJoin2*dvDsc_scale);
        }
        else
        {
                  dvvSel=0.000001;
        }         
    }
    return dvvSel;

FUNCTION CalFleetSelectivity
    dvariable dvAlpha1;
    dvariable dvBeta1;
    dvariable dvAlpha2;
    dvariable dvBeta2;
    dvariable dvTemp1;
    dvariable dvTemp2;
    dvariable dvMax;
    dvar_vector  dvvP_temp(1,6);  
    double dBinwidth_temp;
  
    Md4SelByFleet.initialize();

    for(i=1;i<=DiFleetNum;i++)
    {
      for(k=1;k<=DiSeasonNum;k++)
      {          
           for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
           {                         
                   ii=int(Dd3FleetSelBlockFlag(k,j,i+1)+0.01);              //get selectivity block
                   lL2=DivFleetSelParaIndex(ii);                 //get location of parameter
                   iL1=DimCSelStartSizeBin(i,k);                            //selectivity start size bin
                   iL2=DimCSelEndSizeBin(i,k);                             //selectivity end size bin
                   
                   
                   switch(DivFleetSelBlockFlag(ii))             // whether the selectivity was same as fleet no. x x in ivFleetSelBlockFlag(lL1)
                   {
                     case 1:
                           for(kk=iL1;kk<=iL2;kk++)
                                Md4SelByFleet(i,k,j,kk)= PbnvFleetSelPara(lL2+kk);
                           break;
                     
                     case 2:
                           dvAlpha1= PbnvFleetSelPara(lL2+1);
                           dvBeta1= PbnvFleetSelPara(lL2+2);   
                           
                           for(kk=iL1;kk<=iL2;kk++)
                           {
                             temp=(DvSizeBinData(kk)+DvSizeBinData(kk-1))*0.5;
                             Md4SelByFleet(i,k,j,kk) =1.0/(1.0+mfexp((dvAlpha1-temp)* dvBeta1));
                           }
                          dvMax=max(Md4SelByFleet(i,k,j));
                          Md4SelByFleet(i,k,j)/= dvMax;
                          break;

                     case 3:
                          dvAlpha1= PbnvFleetSelPara(lL2+1);
                          dvBeta1= PbnvFleetSelPara(lL2+2);      
                          dvAlpha2= PbnvFleetSelPara(lL2+3);
                          dvBeta2= PbnvFleetSelPara(lL2+4);      

                          for(kk=iL1;kk<=iL2;kk++)
                          {     
                                  temp=(DvSizeBinData(kk)+DvSizeBinData(kk-1))*0.5;
                                  dvTemp1 =1.0/(1.0+mfexp((dvAlpha1-temp)* dvBeta1));
                                  dvTemp2 =1.0-1.0/(1.0+mfexp((dvAlpha2-temp)* dvBeta2));
                                  Md4SelByFleet(i,k,j,kk)=dvTemp1*dvTemp2;
                          }
                          dvMax=max(Md4SelByFleet(i,k,j));
                          Md4SelByFleet(i,k,j)/= dvMax;
                          break;   
                        
                     case 4:
                          dBinwidth_temp=20.0;
                          dvvP_temp(1)= PbnvFleetSelPara(lL2+1);
                          dvvP_temp(2)= PbnvFleetSelPara(lL2+2);         
                          dvvP_temp(3)= PbnvFleetSelPara(lL2+3);
                          dvvP_temp(4)= PbnvFleetSelPara(lL2+4);         
                          
                          for(kk=iL1;kk<=iL2;kk++)
                          {                         
                              Md4SelByFleet(i,k,j,kk)=DoubleNormalSel(dvvP_temp,iL1,iL2,kk,dBinwidth_temp,0);
                          }
                          dvMax=max(Md4SelByFleet(i,k,j));
                          Md4SelByFleet(i,k,j)/= dvMax;
                          break;    
                        
                     case 5:                         
                          dBinwidth_temp=20.0;
                          dvvP_temp(1)= PbnvFleetSelPara(lL2+1);
                          dvvP_temp(2)= PbnvFleetSelPara(lL2+2);
                          dvvP_temp(3)= PbnvFleetSelPara(lL2+3);
                          dvvP_temp(4)= PbnvFleetSelPara(lL2+4);
                          dvvP_temp(5)= PbnvFleetSelPara(lL2+5);
                          dvvP_temp(6)= PbnvFleetSelPara(lL2+6);
                           
                          
                          for(kk=iL1;kk<=iL2;kk++)
                          {                         
                              Md4SelByFleet(i,k,j,kk)=DoubleNormalSel(dvvP_temp,iL1,iL2,kk,dBinwidth_temp,1);
                          }
                          dvMax=max(Md4SelByFleet(i,k,j));
                          Md4SelByFleet(i,k,j)/= dvMax;
                          break;                  
                   }              
           }
      }
    }

    #if Debug_Status
      // ICHECKDEB(Md4SelByFleet);
    #endif
    return;
 
FUNCTION CalIndexSelectivity
    dvariable dvAlpha1;
    dvariable dvBeta1;
    dvariable dvAlpha2;
    dvariable dvBeta2;
    dvariable dvTemp1;
    dvariable dvTemp2;
    dvariable dvMax;
    dvar_vector  dvvP_temp(1,6);
    double dBinwidth_temp;

    for(i=1;i<=DiIndexNum;i++)
    {
      if(DivRecruitIndexFlag(i)==0)                  //not special index
      {
        for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
        {        
            if(DivIndexFleetSelChoiceFlag(i)<0)  //not use fleet selectivity
            {  
              ii=DimIndexSelBlockFlag(j,i+1);      //block;
              lL2=DivIndexSelParaIndex(ii);    //cumulative number of paras before starting block
              iL1=DivIndexSelStartSizeBin(i);  //selectivity start size bin
              iL2=DivIndexSelEndSizeBin(i);    //selectivity end size bin

              switch(DivIndexSelFlag(ii))
              {
                case 1:
                      for(kk=iL1;kk<=iL2;kk++)
                            Md3IndexSel(i,j,kk)= PbnvIndexSelPara(lL2+kk);
                      break;
                
                case 2:
                      dvAlpha1= PbnvIndexSelPara(lL2+1);
                      dvBeta1= PbnvIndexSelPara(lL2+2);
                   
                      for(kk=iL1;kk<=iL2;kk++)
                      {
                          temp=(DvSizeBinData(kk)+DvSizeBinData(kk-1))*0.5;
                          Md3IndexSel(i,j,kk) =1.0/(1.0+mfexp((dvAlpha1-temp)* dvBeta1));
                      }
                      dvMax=max(Md3IndexSel(i,j));
                      Md3IndexSel(i,j)/= dvMax;
                      break;
               
                case 3:
                      dvAlpha1= PbnvIndexSelPara(lL2+1);
                      dvBeta1= PbnvIndexSelPara(lL2+2); 
                      dvAlpha2= PbnvIndexSelPara(lL2+3);
                      dvBeta2= PbnvIndexSelPara(lL2+4);
                      
                      for(kk=iL1;kk<=iL2;kk++)
                      {
                          temp=(DvSizeBinData(kk)+DvSizeBinData(kk-1))*0.5;
                          dvTemp1 =1.0/(1.0+mfexp((dvAlpha1-temp)* dvBeta1));
                          dvTemp2 =1.0-1.0/(1.0+mfexp((dvAlpha2-temp)* dvBeta2));
                          Md3IndexSel(i,j,kk)=dvTemp1*dvTemp2;
                      }
                      dvMax=max(Md3IndexSel(i,j));
                      Md3IndexSel(i,j)/= dvMax;
                      break;
                
                case 4:
                      dBinwidth_temp=20.0;
                      dvvP_temp(1)= PbnvIndexSelPara(lL2+1);
                      dvvP_temp(2)= PbnvIndexSelPara(lL2+2);         
                      dvvP_temp(3)= PbnvIndexSelPara(lL2+3);
                      dvvP_temp(4)= PbnvIndexSelPara(lL2+4);         
                      
                      for(kk=iL1;kk<=iL2;kk++)
                          {                         
                              Md3IndexSel(i,j,kk)=DoubleNormalSel(dvvP_temp,iL1,iL2,kk,dBinwidth_temp,0);
                          }
                      dvMax=max(Md3IndexSel(i,j));
                      Md3IndexSel(i,j)/= dvMax;
                      break;    
                        
                case 5:                         
                      dBinwidth_temp=20.0;
                      dvvP_temp(1)= PbnvIndexSelPara(lL2+1);
                      dvvP_temp(2)= PbnvIndexSelPara(lL2+2);
                      dvvP_temp(3)= PbnvIndexSelPara(lL2+3);
                      dvvP_temp(4)= PbnvIndexSelPara(lL2+4);
                      dvvP_temp(5)= PbnvIndexSelPara(lL2+5);
                      dvvP_temp(6)= PbnvIndexSelPara(lL2+6);

                      for(kk=iL1;kk<=iL2;kk++)
                          {                         
                              Md3IndexSel(i,j,kk)=DoubleNormalSel(dvvP_temp,iL1,iL2,kk,dBinwidth_temp,1);
                          }
                      dvMax=max(Md3IndexSel(i,j));
                      Md3IndexSel(i,j)/= dvMax;
                      break;
              }
           }
           else                                          //use fleet selectivity
           {
              lL2=DivIndexFleetSelChoiceFlag(i);        // get fleet              
              lL1=int(Dd3IndexMonthFlag(i,j,1)+0.001);
              for(kk=iL1;kk<=iL2;kk++)
              {
                  Md3IndexSel(i,j,kk)= Md4SelByFleet(lL2,lL1,j,kk);
              }              
           }          
        }
      }
    }
    #if Debug_Status
       //ICHECKDEB(Md3IndexSel);
    #endif
    return;

FUNCTION void CalGrowthMatrix_Func(const dvariable &dvLinf,const dvariable &dvK,const dvariable &dvLSigma,const dvariable &dvKSigma,const dvariable &dvRho,double dAlpha,int iStepX,int iStepY,const int iBlock)
    int i,j,k;
    dvariable dvEMinusK;
    dvariable dvEMinusK2;
    dvariable dv1EMinusK;
    dvariable dv1EMinusK2;
    dvariable dvTemp2;
    dvariable fun_dvIntegral;
    double    dLCurrent;
    double    dLDelta;
 
    dvEMinusK=mfexp(-dAlpha*dvK);
    dvEMinusK2=dvEMinusK*dvEMinusK;
    dv1EMinusK=1.0-dvEMinusK;
    dv1EMinusK2=dv1EMinusK*dv1EMinusK;

    for(i=1;i<=DiSizeBinNum;i++)
    {       
          dLDelta=DvSizeBinData(i)-DvSizeBinData(i-1); //increment
          dLCurrent= DvSizeBinData(i-1)+dLDelta*0.5; //mid-point of a given size class
          MnDeltaL=(dvLinf-dLCurrent)*dv1EMinusK+dLCurrent;
          MnDeltaLVar=dvLSigma*dvLSigma*dv1EMinusK2+(dvLinf-dLCurrent)*(dvLinf-dLCurrent)*dvKSigma*dvKSigma*dvEMinusK2*dAlpha*dAlpha;
          MnDeltaLVar+=2*dvRho*dvLSigma*dvKSigma*dv1EMinusK*(dvLinf-dLCurrent)*dvEMinusK*dAlpha;

          for(k=i;k<=DiSizeBinNum;k++)
          {  
             // Method 1 to calculate integrate: use built in function cumd_norm for standard normal distribution           
             MnZscore1=((DvSizeBinData(k-1))-MnDeltaL)/sqrt(MnDeltaLVar);
             MnZscore2=((DvSizeBinData(k))-MnDeltaL)/sqrt(MnDeltaLVar);
             Md3GrowthMatrix(iBlock,i,k)=cumd_norm(MnZscore2)-cumd_norm(MnZscore1);
             
             /*
             //Method 2 to calculate integrate: use user-defined function Integrate
             fun_dvIntegral=Integrate(MnDeltaL,MnDeltaLVar,DvSizeBinData(k-1),DvSizeBinData(k),iStepX);
             Md3GrowthMatrix(iBlock,i,k)=fun_dvIntegral;
             */
             // Note: These two methods have slightly different outcomes, but the difference is very small.
          }
       
       
       dvTemp2=sum(Md3GrowthMatrix(iBlock,i));
       if(dvTemp2>0)
            Md3GrowthMatrix(iBlock,i)/=dvTemp2;
    }
    return;

FUNCTION void CalGrowthMatrix_Func_Avg(const dvariable &dvLinf,const dvariable &dvK,const dvariable &dvLSigma,const dvariable &dvKSigma,const dvariable &dvRho,double dAlpha,int iStepX,int iStepY,const int iBlock)
    int i,j,k;
    dvariable dvEMinusK;
    dvariable dvEMinusK2;
    dvariable dv1EMinusK;
    dvariable dv1EMinusK2;
    dvariable dvTemp2;
    dvariable fun_dvIntegral;
    double    dLCurrent;
    double    dLDelta;
 
    dvEMinusK=mfexp(-dAlpha*dvK);
    dvEMinusK2=dvEMinusK*dvEMinusK;
    dv1EMinusK=1.0-dvEMinusK;
    dv1EMinusK2=dv1EMinusK*dv1EMinusK;

    for(i=1;i<=DiSizeBinNum;i++)
    {       
          dLDelta=DvSizeBinData(i)-DvSizeBinData(i-1); //increment
          dLCurrent= DvSizeBinData(i-1)+dLDelta*0.5; //mid-point of a given size class
          MnDeltaL=(dvLinf-dLCurrent)*dv1EMinusK+dLCurrent;
          MnDeltaLVar=dvLSigma*dvLSigma*dv1EMinusK2+(dvLinf-dLCurrent)*(dvLinf-dLCurrent)*dvKSigma*dvKSigma*dvEMinusK2*dAlpha*dAlpha;
          MnDeltaLVar+=2*dvRho*dvLSigma*dvKSigma*dv1EMinusK*(dvLinf-dLCurrent)*dvEMinusK*dAlpha;

          for(k=i;k<=DiSizeBinNum;k++)
          {  
             // Method 1 to calculate integrate: use built in function cumd_norm for standard normal distribution           
             MnZscore1=((DvSizeBinData(k-1))-MnDeltaL)/sqrt(MnDeltaLVar);
             MnZscore2=((DvSizeBinData(k))-MnDeltaL)/sqrt(MnDeltaLVar);
             Md3GrowthMatrix_Avg(iBlock,i,k)=cumd_norm(MnZscore2)-cumd_norm(MnZscore1);
             
             /*
             //Method 2 to calculate integrate: use user-defined function Integrate
             fun_dvIntegral=Integrate(MnDeltaL,MnDeltaLVar,DvSizeBinData(k-1),DvSizeBinData(k),iStepX);
             Md3GrowthMatrix_Avg(iBlock,i,k)=fun_dvIntegral;
             */
             // Note: These two methods have slightly different outcomes, but the difference is very small.
          }
       
       
       dvTemp2=sum(Md3GrowthMatrix_Avg(iBlock,i));
       if(dvTemp2>0)
            Md3GrowthMatrix_Avg(iBlock,i)/=dvTemp2;
    }
    return;

FUNCTION CalFleetFishingMortality      
    Md3Ftot.initialize();
    Md4FASByFleet.initialize();
    Md3Ft.initialize();
    Md3Z.initialize();
    Md3S.initialize();
    MmSSB_S.initialize();
    sdr_vAnnualF.initialize();
    MmFseason.initialize();

    for(i=1;i<=DiFleetNum;i++)
    {
      for(k=1;k<=DiSeasonNum;k++)
      {
           for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
           {
                  iL2=(i-1)*DiSeasonNum*DiCalYearNum+(k-1)*DiCalYearNum+j;
                  lL2=(k-1)*DiCalYearNum+j;                            // zero catch fleet
                  if(DimFleetFZeroIndex(i,lL2)>0) 
                  {
                    Md3Ft(i,k,j)=PbnvFishingMortalityPara(iL2);
                  }
                  else
                  {
                    Md3Ft(i,k,j)=0.0;
                  }
                     
                  for(kk=1;kk<=DiSizeBinNum;kk++)
                  {
                     Md4FASByFleet(i,k,j,kk)=Md3Ft(i,k,j)*Md4SelByFleet(i,k,j,kk);
                     Md3Ftot(k,j,kk)+=Md4FASByFleet(i,k,j,kk);
                  }

               MmFseason(k,j) +=Md3Ft(i,k,j);
               sdr_vAnnualF(j) +=Md3Ft(i,k,j);
           }
      }
    }
  
    for(i=1;i<=DiSeasonNum;i++)
    {
        for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
        {
             for(k=1;k<=DiSizeBinNum;k++)
             {
                 Md3Z(i,j,k)= Md3Ftot(i,j,k)+Md3M(i,j,k);
             }
        }      
    }

    Md3S=mfexp(-1.0*Md3Z);

    for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
    {
             for(k=1;k<=DiSizeBinNum;k++)
             {
                 MmSSB_S(j,k)=mfexp(-1.0*DnFracSeasonSSB*Md3Z(DiSSBSeason,j,k));
             }
    }  
   
    #if Debug_Status
       ICHECKDEB(Md3Ftot);
       ICHECKDEB(Md3Z);
       ICHECKDEB(Md4FASByFleet);
       ICHECKDEB(Md3Ft);
    #endif
    return;

FUNCTION GetNYear1Season1
    dvariable dvTempN;
    dvariable dvTempSigma;
    dvariable dvTempU;
    dvariable dvTempSigma1;
    dvariable dvTempU1;
    dvariable dvTempSigma2;
    dvariable dvTempU2;
    dvariable dvpi1;
    dvariable dvpi2;
    dvariable sump;
    double    dL;
    int       i;
    MvNASTemp.initialize();
      
    switch(DiNYear1ChoiceFlag)
    {
          case 0:
                for(i=1;i<=DiSizeBinNum;i++)
                        MvNASTemp(i)= PbnvNYear1Para(i);
                break;
          case 1:
                dvTempN= PbnvNYear1Para(1);
                for(i=1;i<=DiSizeBinNum;i++)
                       MvNASTemp(i)=DvNYear1Pia(i)* dvTempN;
                break;
          case 2:
               dvTempN= PbnvNYear1Para(1);
               for(i=1;i<=DiSizeBinNum;i++)
                       MvNASTemp(i)=mfexp(DvNYear1Pia(i))/(1.0+mfexp(DvNYear1Pia(i)))* dvTempN;
               break;
          case 3://log-normal distribution 
               dvTempN=PbnvNYear1Para(1);
               dvTempU=PbnvNYear1Para(2);
               dvTempSigma=PbnvNYear1Para(3);
               for(i=1;i<=DiSizeBinNum;i++)
               {
                       dL=0.5*(DvSizeBinData(i-1)+ DvSizeBinData(i));
                       MnTemp1=1.0/(sqrt(PI2)*dvTempSigma*dL)*mfexp(-(log(dL)-dvTempU)*(log(dL)-dvTempU)/( dvTempSigma* dvTempSigma*2.0));
                       MvNASTemp(i)=MnTemp1*dvTempN;
                       //cout<< dL<<"\t"<<dvTempU<<"\t"<<dvTempSigma<<"\t"<<MnTemp1<<"\t"<<MvNASTemp(i)<<endl;
               }
               //exit(-99);
               break;
               
          case 4://log-normal distribution
               dvTempN=PbnvNYear1Para(1);
               dvTempU=PbnvNYear1Para(2);
               dvTempSigma=PbnvNYear1Para(3);
               for(i=1;i<=DiSizeBinNum;i++)
               {
                       dL=0.5*(DvSizeBinData(i-1)+ DvSizeBinData(i));
                       MnTemp1=1.0/(sqrt(PI2)*dvTempSigma*dL)*mfexp(-(log(dL)-dvTempU)*(log(dL)-dvTempU)/( dvTempSigma* dvTempSigma*2.0));
                       MvNASTemp(i)=mfexp( MnTemp1)/(1.0+mfexp( MnTemp1))* dvTempN;
               }
               break;
           case 5://normal distribution 
               dvTempN=PbnvNYear1Para(1);
               dvTempU=PbnvNYear1Para(2);
               dvTempSigma=PbnvNYear1Para(3);
               for(i=1;i<=DiSizeBinNum;i++)
               {
                       dL=0.5*(DvSizeBinData(i-1)+ DvSizeBinData(i));
                       MnTemp1=1.0/(sqrt(PI2)*dvTempSigma)*mfexp(-(dL-dvTempU)*(dL-dvTempU)/( dvTempSigma* dvTempSigma*2.0));
                       MvNASTemp(i)=MnTemp1*dvTempN;
               }
               break;
           case 6://normal distribution 
               dvTempN=	PbnvNYear1Para(1);
               dvTempU=	PbnvNYear1Para(2);
               dvTempSigma= PbnvNYear1Para(3);
               for(i=1;i<=DiSizeBinNum;i++)
               {
                       dL=0.5*(DvSizeBinData(i-1)+ DvSizeBinData(i));
                       MnTemp1=1.0/(sqrt(PI2)*dvTempSigma)*mfexp(-(dL-dvTempU)*(dL-dvTempU)/( dvTempSigma* dvTempSigma*2.0));
                       MvNASTemp(i)=mfexp( MnTemp1)/(1.0+mfexp( MnTemp1))* dvTempN;
               }
               break;
           case 7://mixtrue distributions
               dvTempN=	PbnvNYear1Para(1);
               dvTempU=	PbnvNYear1Para(2);
               dvTempSigma= PbnvNYear1Para(3);
               dvTempU1=PbnvNYear1Para(4);
               dvTempSigma1= PbnvNYear1Para(5);
               dvTempU2=PbnvNYear1Para(6);
               dvTempSigma2= PbnvNYear1Para(7);
               dvpi1=PbnvNYear1Para(8);
               dvpi2=PbnvNYear1Para(9);
       
               for(i=1;i<=DiSizeBinNum;i++)
               {
                       dL=0.5*(DvSizeBinData(i-1)+ DvSizeBinData(i));
                       MnTemp1=1.0/(sqrt(PI2)*dvTempSigma)*mfexp(-(dL-dvTempU)*(dL-dvTempU)/( dvTempSigma* dvTempSigma*2.0));
                       MnTemp2=1.0/(sqrt(PI2)*dvTempSigma1)*mfexp(-(dL-dvTempU1)*(dL-dvTempU1)/( dvTempSigma1* dvTempSigma1*2.0));
                       MnTemp3=1.0/(sqrt(PI2)*dvTempSigma2)*mfexp(-(dL-dvTempU2)*(dL-dvTempU2)/( dvTempSigma2* dvTempSigma2*2.0));
                       MvNASTemp(i)=(dvpi1*MnTemp1+dvpi2*MnTemp2+(1-dvpi1-dvpi2)*MnTemp3);
                 
               }
               sump=sum(MvNASTemp);
               for(i=1;i<=DiSizeBinNum;i++)
               {
                       MvNASTemp(i)= (MvNASTemp(i)/sump)*dvTempN;
               }
               break;
    }
      
    #if Debug_Status
       //ICHECKDEB(MvNASTemp);
    #endif
    return;

FUNCTION   CalGrowthMatrix
    int      i,iL1,j,ii;

    Md3GrowthMatrix.initialize();
    MvBaseLinf.initialize();
    MvBaseK.initialize();

    if(DiGrowthMatrixFlag==0)
    {
      for(i=1;i<=DiGrowthMatrixBlockNum;i++)
      {
             for(j=1;j<=DiSeasonNum;j++)
             {
                  iL1=(i-1)*DiSeasonNum+j;
                  Md3GrowthMatrix(iL1).initialize();
                  for(ii=1;ii<=DiSizeBinNum;ii++)
                  {
                      for(k=1;k<=DiSizeBinNum;k++)
                      {
                          Md3GrowthMatrix(iL1,ii,k)= Dd3GrowthMatrix_Ini(iL1,ii,k);
                      }
                  }
             }
      }
    }
    
    if(DiGrowthMatrixFlag==1)
    {     
        for(i=1;i<=DiGrowthMatrixBlockNum;i++)
        {                                   
              for(j=1;j<=DiSeasonNum;j++)
              {
                    MvBaseLinf(i)=PbnvGrowthPara((i-1)*5+1);
                    MvBaseK(i)=PbnvGrowthPara((i-1)*5+2);

                    iL1=(i-1)*DiSeasonNum+j;
                    Md3GrowthMatrix(iL1).initialize();
                    CalGrowthMatrix_Func(MvBaseLinf(i),MvBaseK(i),PbnvGrowthPara((i-1)*5+3),PbnvGrowthPara((i-1)*5+4),PbnvGrowthPara((i-1)*5+5),DvGrowthTimeAsYear(j),20,0,iL1);
               }
        }
    }

    if(DiGrowthMatrixFlag==2)    //random walk
    {
        MvBaseLinf(1)=PbnvGrowthPara(1);
        MvBaseK(1)=PbnvGrowthPara(2);

        for(i=2;i<=DiGrowthMatrixBlockNum;i++)
        {
            MvBaseLinf(i)=MvBaseLinf(i-1)*mfexp(PbnvLinfDevPara(i));
            MvBaseK(i)=MvBaseK(i-1)*mfexp(PbnvKDevPara(i));
        }
        
        for(i=1;i<=DiGrowthMatrixBlockNum;i++)
        {                                   
              for(j=1;j<=DiSeasonNum;j++)
              {
                    iL1=(i-1)*DiSeasonNum+j;
                    Md3GrowthMatrix(iL1).initialize();
                    CalGrowthMatrix_Func(MvBaseLinf(i),MvBaseK(i),PbnvGrowthPara(3),PbnvGrowthPara(4),PbnvGrowthPara(5),DvGrowthTimeAsYear(j),20,0,iL1);
               }
        }
    }

    if(DiGrowthMatrixFlag==3)    //annual avg with random deviation
    {
        for(i=1;i<=DiGrowthMatrixBlockNum;i++)
        {
            MvBaseLinf(i)=PbnvGrowthPara(1)*mfexp(PbnvLinfDevPara2(i));
            MvBaseK(i)=PbnvGrowthPara(2)*mfexp(PbnvKDevPara2(i));
        }
        
        for(i=1;i<=DiGrowthMatrixBlockNum;i++)
        {                                   
              for(j=1;j<=DiSeasonNum;j++)
              {
                    iL1=(i-1)*DiSeasonNum+j;
                    Md3GrowthMatrix(iL1).initialize();
                    CalGrowthMatrix_Func(MvBaseLinf(i),MvBaseK(i),PbnvGrowthPara(3),PbnvGrowthPara(4),PbnvGrowthPara(5),DvGrowthTimeAsYear(j),20,0,iL1);
               }
        }
    }
    return;

FUNCTION CalNumberAtSize
    dvariable    dvAlpha,dvBeta;

    if(DiRSFlag==1)
    {
        dvAlpha=PbnvRecruitPara(1);
        dvBeta=0.0;
    }
    else
    {
        dvAlpha=PbnvRecruitPara(1);
        dvBeta=PbnvRecruitPara(2); 
    }
  
    Md3NAS.initialize();
    MvRecruitDev.initialize();
    MvRecruitRS.initialize();
    sdr_vSSB.initialize();
    MvRecruitSizeProp.initialize();
    sdr_vAnnualN.initialize();
    sdr_vAnnualN_NoR.initialize();
   
    for(i=1;i<=DiRecruitSizeBinNum;i++)
          MvRecruitSizeProp(i)=PbnvRecruitSizePropPara(i)/sum(PbnvRecruitSizePropPara);
  
    //// Year 1 season 1
    GetNYear1Season1();
    for (i=1;i<=DiSizeBinNum;i++)  
             Md3NAS(1,DiCalBeginYear,i)=MvNASTemp(i);

    //// Annual recruit
    //// 1st time step (1st year 1st season) no need R, so adding R starts from 2nd time step (1st year 2nd season)
    //// age-0 is recruit, so SSB_y gives R_y, no 1-yr lag
   
    sdr_vSSB(DiCalBeginYear)=elem_prod(elem_prod(elem_prod(Md3NAS(1,DiCalBeginYear),MmSSB_S(DiCalBeginYear)),DmMaturityAtSize(DiCalBeginYear)),DmWeightAtSize_MtPer1000Fish(DiCalBeginYear))*DmFemalePropAtSize(DiCalBeginYear);
    MvRecruitDev(DiCalBeginYear)=PbnvRecruitDevPara(DiCalBeginYear);
    MvRecruitRS(DiCalBeginYear)=CalStockRecruitment(sdr_vSSB(DiCalBeginYear),dvAlpha,dvBeta,DiRSFlag); //0.0; cannot converge if set to zero
    sdr_vRecruitmentP(DiCalBeginYear)=MvRecruitRS(DiCalBeginYear)*mfexp(MvRecruitDev(DiCalBeginYear));
  
    //// Annual N
    for(i=DiCalBeginYear;i<=DiCalEndYear;i++)
    {
       sdr_vAnnualN_NoR(i)=sum(Md3NAS(1,i));                //record abundance at the beginning of the year,i.e., the begning of the 1st season, no recruits added

       if(i>DiCalBeginYear)
        {    
           //MvRecruitDev(i)=sqrt(PbnRecruitRhPara+0.0000000001)*MvRecruitDev(i-1)+sqrt(1.0000000001-PbnRecruitRhPara)*PbnvRecruitDevPara(i);  //PbnRecruitRhPara is auto-correlation coefficient, usually set to 0
           MvRecruitDev(i)=PbnvRecruitDevPara(i);
           sdr_vRecruitmentP(i)=MvRecruitRS(i)*mfexp(MvRecruitDev(i));
        } 
       
       for(j=1;j<=DiSeasonNum;j++)
       {        
             Md3NAS(j,i)=Md3NAS(j,i)+sdr_vRecruitmentP(i)*DvRecruitmentSeaProp(j)*MvRecruitSizeProp;
             
             if(j==1)
                 sdr_vAnnualN(i)=sum(Md3NAS(j,i));                //record abundance at the beginning of the year,i.e., the begning of the 1st season, include recruits
                        
             if(j==DiSSBSeason)
             {
                sdr_vSSB(i)=elem_prod(elem_prod(elem_prod(Md3NAS(j,i),MmSSB_S(i)),DmMaturityAtSize(i)),DmWeightAtSize_MtPer1000Fish(i))*DmFemalePropAtSize(i);  //SSB in metric tons
                if(i<DiCalEndYear)
                      MvRecruitRS(i+1)=CalStockRecruitment(sdr_vSSB(i),dvAlpha,dvBeta,DiRSFlag);
             }
             
             iL2=DimGrowthMatrixBlockFlag(i,j+1);
             iL1=(iL2-1)*DiSeasonNum+j;
             MvNASTemp=elem_prod(Md3NAS(j,i),Md3S(j,i))*Md3GrowthMatrix(iL1);   //die and grow  N(m+1,t)=(N(m,t)*exp(-Z)*G)
             
             if(j<DiSeasonNum)
             { 
                Md3NAS(j+1,i)= MvNASTemp;      //Growing to next Season in the same year
             }
             else
             {
                if(i<DiCalEndYear)
                      Md3NAS(1,i+1)= MvNASTemp;      //Growing to next year
             }
       }
    }
    
    //cout<<Md3NAS<<endl;
    //exit(110);

    #if Debug_Status
        //ICHECKDEB(MvRecruitRS);
        //ICHECKDEB(sdr_vRecruitmentP);
        ICHECKDEB(Md3NAS);
  
    #endif
    return;
 

FUNCTION CalPredictedCatchAtSize
    dvariable  dvTotal;
    Md4CatchPropAtSizeP.initialize();
    Md4CatchAtSizeP.initialize();
    Md3CatchTotalP.initialize();
  
    for(i=1;i<=DiFleetNum;i++)
    {
      for(j=1;j<=DiSeasonNum;j++)
      {
        Md4CatchAtSizeP(i,j)=elem_prod(elem_div(Md4FASByFleet(i,j),Md3Z(j)),elem_prod(1.0-Md3S(j),Md3NAS(j)));
      }
    }
 
    for (i=1;i<=DiFleetNum;i++)
    {
      for(j=1;j<=DiSeasonNum;j++)
      {
         for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
         {
            if (Dd3CatchTotalO(i,j,k)>MINPOSITIVE)
            {
               if(DimCatchBiomassFlag(i,j)==1)   // in weight
                   Md3CatchTotalP(i,j,k)= Md4CatchAtSizeP(i,j,k)(DimCSelStartSizeBin(i,j),DimCSelEndSizeBin(i,j))*DmWeightAtSize_MtPer1000Fish(k)(DimCSelStartSizeBin(i,j),DimCSelEndSizeBin(i,j));
               else                             // in Number 
                   Md3CatchTotalP(i,j,k)= sum(Md4CatchAtSizeP(i,j,k)(DimCSelStartSizeBin(i,j),DimCSelEndSizeBin(i,j)));
               
               if(Dd3CatchESSInput(i,j,k)>0)
               {
                   dvTotal=sum(Md4CatchAtSizeP(i,j,k)(DimCSelStartSizeBin(i,j),DimCSelEndSizeBin(i,j)));
                   if(dvTotal>0)
                        Md4CatchPropAtSizeP(i,j,k)(DimCSelStartSizeBin(i,j),DimCSelEndSizeBin(i,j))= Md4CatchAtSizeP(i,j,k)(DimCSelStartSizeBin(i,j),DimCSelEndSizeBin(i,j))/dvTotal;
               }            
            }
         }
      }
    }
    return;

FUNCTION CalIndexQAndComp
    ivector ivCount(1,DiIndexQBlockNum);    
    ivCount=0;
  
    MvIndexQ.initialize();
    Md3NASIndexBar.initialize();
    MmBiomassSurvey.initialize();
    Md3IndexPropAtSizeP.initialize();
    MmIndexP.initialize();
  
    for(i=1;i<=DiIndexNum;i++)
    {      
      for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
      {
        if(DmIndexTotalO(i,j)>MINPOSITIVE)             //non-zero Year
        {
          if(DivRecruitIndexFlag(i)==0)               // non special index
          {                          
              lL1=int(Dd3IndexMonthFlag(i,j,1)+0.001);      //season
              temp=Dd3IndexMonthFlag(i,j,2);               //month fraction within season
          
              Md3NASIndexBar(i,j)=elem_prod(mfexp(temp*Md3Z(lL1,j)),Md3NAS(lL1,j));
         
              Md3NASIndexBar(i,j)=elem_prod(Md3NASIndexBar(i,j),Md3IndexSel(i,j));   // NSurvey(j,t)
         
              if(DivIndexUnitsFlag(i)==1)
                  MvTemp1=elem_prod(Md3NASIndexBar(i,j),DmWeightAtSize_MtPer1000Fish(j));
              else
                  MvTemp1=Md3NASIndexBar(i,j);
         
              MmBiomassSurvey(i,j)=sum(MvTemp1(DivIndexSelStartSizeBin(i),DivIndexSelEndSizeBin(i))); //NSurvey(t)
          }
          else                                              // recruitment index
          {
              if(DivIndexUnitsFlag(i)==1)
                  MmBiomassSurvey(i,j)=sdr_vRecruitmentP(j)*sum(DmWeightAtSize_MtPer1000Fish(j)(1,DiRecruitSizeBinNum))/DiRecruitSizeBinNum;  //use average weight across recruit size bins
                  //MmBiomassSurvey(i,j)=sdr_vRecruitmentP(j)*MvRecruitSizeProp(1,DiRecruitSizeBinNum)*DmWeightAtSize_MtPer1000Fish(j)(1,DiRecruitSizeBinNum);  //use size-specific weight for recruit size bins
              else
                  MmBiomassSurvey(i,j)=sdr_vRecruitmentP(j);
          }
          
          iL1=DimIndexQBlockFlag(j,i+1); //index old q          
          switch(DivIndexQChoiceFlag(iL1))
          {
           case 1:
                MvIndexQ(iL1)+=log(DmIndexTotalO(i,j)/pow(MmBiomassSurvey(i,j),PbnvIndexQPara(iL1)));
                ivCount(iL1)++;
                break;
           
           case 2:
                MvIndexQ(iL1)+=DmIndexTotalO(i,j)/pow(MmBiomassSurvey(i,j),PbnvIndexQPara(iL1));
                ivCount(iL1)++;
                break;
           
           default:
                break;
          }
        }
      }
    }

    for(iL2=1;iL2<=DiIndexQBlockNum;iL2++)
    {
          switch(DivIndexQChoiceFlag(iL2))
         {
            case 1:
                  if(ivCount(iL2)>0)
                      MvIndexQ(iL2)=mfexp(MvIndexQ(iL2)/ivCount(iL2));
                  else
                      MvIndexQ(iL2)=0.0;
                  break;
            
            case 2:
                  if(ivCount(iL2)>0)
                      MvIndexQ(iL2)=MvIndexQ(iL2)/ivCount(iL2);
                  else
                      MvIndexQ(iL2)=0.0;
                  break;
            
            default:
                  break;
        }     
    }
    
    for(i=1;i<=DiIndexNum;i++)
    {
      for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
      {
        if(DmIndexTotalO(i,j)>MINPOSITIVE) // non-zero year
        {
         iL2=DimIndexQBlockFlag(j,i+1);   //index old q
         
         MmIndexP(i,j) = MvIndexQ(iL2)*pow(MmBiomassSurvey(i,j),PbnvIndexQPara(iL2));

         if(DivRecruitIndexFlag(i)==0)               // non special index
         { 
             if(DimIndexESSInput(i,j)>0)
             {
                MnTemp1= sum(Md3NASIndexBar(i,j)(DivIndexSelStartSizeBin(i),DivIndexSelEndSizeBin(i)));
                if(MnTemp1>0.0)
                      Md3IndexPropAtSizeP(i,j)(DivIndexSelStartSizeBin(i),DivIndexSelEndSizeBin(i))= Md3NASIndexBar(i,j)(DivIndexSelStartSizeBin(i),DivIndexSelEndSizeBin(i))/MnTemp1;
             }
         }
        }
      }
    }
   
    //cout<<DmIndexTotalO<<endl;

    #if Debug_Status
      ICHECKDEB(MmIndexP);
      ICHECKDEB(MvIndexQ);
      ICHECKDEB(Md3IndexPropAtSizeP);
    #endif
    return;

FUNCTION dvariable EnvZscoreMean(const dvar_vector &dvEnv, ivector dvIndex)
    dvariable dvTemp;
    int       i,k;
    i=sum(dvIndex);  //counter for the number of years with NO missing data;0-missing data;1-no missing data
    dvTemp=0.0;
    for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
    {      
       if(dvIndex(k)>0)  //years with missing data are excluded
       {
          dvTemp+=dvEnv(k);
       }
    }
    if(i>0)
    {
      dvTemp/=i;
    }    
    return dvTemp;

FUNCTION dvariable EnvZscoreSD(const dvar_vector &dvEnv, ivector dvIndex, const dvariable &dvMean)
    dvariable dvTemp;
    int       i,k;
    i=sum(dvIndex);  //counter for the number of years with NO missing data;0-missing data;1-no missing data
    dvTemp=0.0;
    for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
    {      
       if(dvIndex(k)>0)  //years with missing data are excluded
       {
          dvTemp+=(dvEnv(k)-dvMean)*(dvEnv(k)-dvMean);
       }
    }
    if(i>1)
    {
      dvTemp/=(i-1);
      dvTemp=sqrt(dvTemp);
    }
    return dvTemp;

FUNCTION CalEnvFitZcore_Recruit
    dvariable      sumTemp;
    dvariable      meanTemp;
    dvariable      sdTemp;
    DvRecruitEnvZscore.initialize();

    for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
    {
       if(DvRecruitEnvMissDataIndex(k)>0)  //years with missing data are excluded
       {
          sumTemp=PbnvRecruitEnvPara(1);  //intercept
          for(i=1;i<=DiRecruitEnvNum;i++)
          {
              sumTemp+=DmRecruitEnv(k,i+1)*PbnvRecruitEnvPara(i+1);
          }
          DvRecruitEnvZscore(k)=sumTemp;
       }
    }
    
    meanTemp=EnvZscoreMean(DvRecruitEnvZscore,DvRecruitEnvMissDataIndex);
    sdTemp=EnvZscoreSD(DvRecruitEnvZscore,DvRecruitEnvMissDataIndex,meanTemp);

    ////meanTemp=mean(DvRecruitEnvZscore);
    ////sdTemp=std_dev(DvRecruitEnvZscore);
  
    for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
    {
       if(DvRecruitEnvMissDataIndex(k)>0)
       {
          DvRecruitEnvZscore(k)=(DvRecruitEnvZscore(k)-meanTemp)/sdTemp;
       }
    }
    
    #if Debug_Status
      ICHECKDEB(DvRecruitEnvZscore);
    #endif
    return;

FUNCTION CalEnvFitZcore_NaturalMortality
    dvariable      sumTemp;
    dvariable      meanTemp;
    dvariable      sdTemp;
    MmNaturalMortalityEnvZscore.initialize();

    for(i=1;i<=DiSeasonNum;i++)
    {       
        for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
        {
            if(DimNaturalMortalityEnvMissDataIndex(i,j)>0)  //years with missing data are excluded
            {
               sumTemp=PbnvNaturalMortalityEnvPara(1);  //intercept
               for(k=1;k<=DiNaturalMortalityEnvNum;k++)
               {
                  sumTemp+=Dd3NaturalMortalityEnv(i,j,k)*PbnvNaturalMortalityEnvPara(k+1);
               }
               MmNaturalMortalityEnvZscore(i,j)=sumTemp;
            }
        }
        
        meanTemp=EnvZscoreMean(MmNaturalMortalityEnvZscore(i),DimNaturalMortalityEnvMissDataIndex(i));
        sdTemp=EnvZscoreSD(MmNaturalMortalityEnvZscore(i),DimNaturalMortalityEnvMissDataIndex(i),meanTemp);

        ////meanTemp=mean(MmNaturalMortalityEnvZscore(i));
        ////sdTemp=std_dev(MmNaturalMortalityEnvZscore(i));
  
        for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
        {
            if(DimNaturalMortalityEnvMissDataIndex(i,j)>0)
            {
                MmNaturalMortalityEnvZscore(i,j)=(MmNaturalMortalityEnvZscore(i,j)-meanTemp)/sdTemp;
            }
        }
    }
    
    #if Debug_Status
      ICHECKDEB(MmNaturalMortalityEnvZscore);
    #endif
    return;

FUNCTION CalObjectiveFunc     
    ofvTotal=0.0;
    PriorTotal=0.0;
      
    ///////////////////////////////////////////////////// Observation errors
    MnCatchLikely=0.0;
    MvCatchLikely=0.0;
    for(i=1;i<=DiFleetNum;i++)
    {
          for(j=1;j<=DiSeasonNum;j++)
          {
              for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
              {
                 if(Dd3CatchTotalO(i,j,k)>MINPOSITIVE)
                 {
                     MvCatchLikely(i)+= CalLikelihoodVar(Dd3CatchTotalO(i,j,k),Dd3CatchTotalSigma2(i,j,k),Md3CatchTotalP(i,j,k),DimCatchTotalLikelihoodFlag(i,j))*DmCatchTotalLambda(i,j);  
                 }
              }   
          }
          MnCatchLikely +=MvCatchLikely(i);
    }
    cout<<"Catch likelihood:"<<MvCatchLikely<<endl;
       
    MvCatchPropLikely=0.0;
    for(i=1;i<=DiFleetNum;i++)
    {
              for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
              {
                       for(k=1;k<=DiSeasonNum;k++)
                      {
                        if(Dd3CatchTotalO(i,k,j)>MINPOSITIVE)  // non-zero year
                        {
                            iTemp=Dd3CatchESSInput(i,k,j);
                            if(iTemp>0)
                            {
                                 iL1=DimCSelStartSizeBin(i,k);
                                 iL2=DimCSelEndSizeBin(i,k);
                                 DvTemp=Dd4CatchPropAtSizeO(i,k,j);
                                 MvTemp1=Md4CatchPropAtSizeP(i,k,j);
                                 MvCatchPropLikely(i)+=CalLikelihoodPropVar(DvTemp,MvTemp1,iTemp,iL1,iL2,DimCatchCompLikelihoodFlag(i,k))*DmCatchCompLambda(i,k);
                            }
                        }
                      }
              }
              MnCatchLikely+=MvCatchPropLikely(i);
      }
      cout<<"Catch composition likelihood:"<<MvCatchPropLikely<<endl;
      ofvTotal+=MnCatchLikely;
      
      MnIndexLikely=0.0;
      MvIndexLikely=0.0; 
      for(i=1;i<=DiIndexNum;i++)
      {
          for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
          {
            if(DmIndexTotalO(i,k)>MINPOSITIVE) // non-zero year
            {
                     MvIndexLikely(i)+= CalLikelihoodVar(DmIndexTotalO(i,k),DmIndexTotalSigma2(i,k),MmIndexP(i,k),DivIndexTotalLikelihoodFlag(i))*DvIndexTotalLambda(i);      
            }
          }
          MnIndexLikely +=MvIndexLikely(i);
      }
      cout<<"Survey index likelihood:"<<MvIndexLikely<<endl;

      MvIndexPropLikely=0.0;
      for(i=1;i<=DiIndexNum;i++)
      {
        if(DivRecruitIndexFlag(i)==0)               // non special index
        { 
               for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
               {
                 if(DmIndexTotalO(i,k)>MINPOSITIVE) // non-zero year
                 {
                      iTemp=DimIndexESSInput(i,k);
                      if(iTemp>0)
                      {
                                 iL1=DivIndexSelStartSizeBin(i);
                                 iL2=DivIndexSelEndSizeBin(i);
                                 DvTemp=Dd3IndexPropAtSizeO(i,k);
                                 MvTemp1=Md3IndexPropAtSizeP(i,k);
                                 MvIndexPropLikely(i)+=CalLikelihoodPropVar(DvTemp,MvTemp1,iTemp,iL1,iL2,DivIndexCompLikelihoodFlag(i))*DvIndexCompLambda(i);
                      }
                 }
              }
              MnIndexLikely+= MvIndexPropLikely(i);
        }
      }
      cout<<"Survey composition likelihood:"<<MvIndexPropLikely<<endl;      
      ofvTotal+= MnIndexLikely;

      MnRecruitEnvLikely=0.0;
      if(DiFlagRecruitEnv>0)
      {
          for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
          {
              if(active(PbnvRecruitDevPara) && DvRecruitEnvMissDataIndex(k)>0)
                   MnRecruitEnvLikely += CalLikelihoodEnv(DvRecruitEnvZscore(k),DnRecruitEnvSigma2,PbnvRecruitDevPara(k))*DnRecruitEnvLambda; //normal deviation
          }
      }      
      cout<<"Environmental variables fit to Rdev likelihood:"<<MnRecruitEnvLikely<<endl;      
      ofvTotal+= MnRecruitEnvLikely;

      MnNaturalMortalityEnvLikely=0.0;
      if(DiFlagNaturalMortalityEnv>0 && DiNaturalMortalityFlag==3)
      {
            ////season 1
            for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
            {
              if(active(PbnvNaturalMortalityDevParaSea1) && DimNaturalMortalityEnvMissDataIndex(1,k)>0)
                   MnNaturalMortalityEnvLikely += CalLikelihoodEnv(MmNaturalMortalityEnvZscore(1,k),DnNaturalMortalityEnvSigma2,PbnvNaturalMortalityDevParaSea1(k))*DnNaturalMortalityEnvLambda; //normal deviation
            }
            ////season 2
            for(k=DiCalBeginYear;k<=DiCalEndYear;k++)
            {
              if(active(PbnvNaturalMortalityDevParaSea2) && DimNaturalMortalityEnvMissDataIndex(2,k)>0)
                   MnNaturalMortalityEnvLikely += CalLikelihoodEnv(MmNaturalMortalityEnvZscore(2,k),DnNaturalMortalityEnvSigma2,PbnvNaturalMortalityDevParaSea2(k))*DnNaturalMortalityEnvLambda; //normal deviation
            }         
      }    
      cout<<"Environmental variables fit to Mdev likelihood:"<<MnNaturalMortalityEnvLikely<<endl;    
      ofvTotal+= MnNaturalMortalityEnvLikely;

      //////////////////////////////////////////////// Process errors
      MnRecruitDevLikely=0.0;
      for(i=DiCalBeginYear;i<=DiCalEndYear;i++)
      {
            if(active(PbnvRecruitDevPara))
            {                         
                MnRecruitDevLikely += CalLikelihoodDev(square(PbnRecruitDevSDPara),PbnvRecruitDevPara(i))*DnRecruitDevParaLambda;
            }                 
      }
        
      cout<<"Recruitment deviation likelihood:"<<MnRecruitDevLikely<<endl;
      ofvTotal+=MnRecruitDevLikely;
      //exit(-99);

      MnLinfDevLikely=0.0;
      if(DiGrowthMatrixFlag==2)
      { 
        for(i=1;i<=DiGrowthDevParaNum;i++)
        {               
          if(active(PbnvLinfDevPara(i)))
          {
                MnLinfDevLikely += CalLikelihoodDev(square(PbnvGrowthDevSDPara(1)),PbnvLinfDevPara(i))*DvLinfDevParaLambda(i);
          }
        } 
      }
      if(DiGrowthMatrixFlag==3)
      { 
        for(i=1;i<=DiGrowthDevParaNum;i++)
        {               
          if(active(PbnvLinfDevPara2))
          {
                MnLinfDevLikely += CalLikelihoodDev(square(PbnvGrowthDevSDPara(1)),PbnvLinfDevPara2(i))*DvLinfDevParaLambda(i);
          }
        } 
      }
      cout<<"Time-varying VB Growth Linf deviation likelihood:"<<MnLinfDevLikely<<endl;
      ofvTotal+=MnLinfDevLikely;

      MnKDevLikely=0.0;
      if(DiGrowthMatrixFlag==2)
      {  
        for(i=1;i<=DiGrowthDevParaNum;i++)
        {              
          if(active(PbnvKDevPara(i)))
          {
                MnKDevLikely += CalLikelihoodDev(square(PbnvGrowthDevSDPara(2)),PbnvKDevPara(i))*DvKDevParaLambda(i);
          }
        }  
      }
      if(DiGrowthMatrixFlag==3)
      {  
        for(i=1;i<=DiGrowthDevParaNum;i++)
        {              
          if(active(PbnvKDevPara2))
          {
                MnKDevLikely += CalLikelihoodDev(square(PbnvGrowthDevSDPara(2)),PbnvKDevPara2(i))*DvKDevParaLambda(i);
          }
        }  
      }
      cout<<"Time-varying VB Growth K deviation likelihood:"<<MnKDevLikely<<endl;
      ofvTotal+=MnKDevLikely;   

      MnNaturalMortalityDevLikely=0.0;
      if(DiNaturalMortalityFlag==2)
      { 
        for(i=1;i<=DiSeasonNum;i++)
        {
            for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
            {               
                iL1=(i-1)*DiCalYearNum+j;
                if(active(PbnvNaturalMortalityDevPara(iL1)))
                {
                    MnNaturalMortalityDevLikely += CalLikelihoodDev(square(PbnvNaturalMortalityDevSDPara(i)),PbnvNaturalMortalityDevPara(iL1))*DvNaturalMortalityDevParaLambda(iL1);
                }
            }
        } 
      }
      if(DiNaturalMortalityFlag==3)
      {
        iL1=(1-1)*DiCalYearNum+DiCalBeginYear;
        iL2=(2-1)*DiCalYearNum+DiCalBeginYear;
        for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
        {          
          if(active(PbnvNaturalMortalityDevParaSea1))
          {            
            MnNaturalMortalityDevLikely += CalLikelihoodDev(square(PbnvNaturalMortalityDevSDPara(1)),PbnvNaturalMortalityDevParaSea1(j))*DvNaturalMortalityDevParaLambda(iL1);
          }
          if(active(PbnvNaturalMortalityDevParaSea2))
          {          
            MnNaturalMortalityDevLikely += CalLikelihoodDev(square(PbnvNaturalMortalityDevSDPara(2)),PbnvNaturalMortalityDevParaSea2(j))*DvNaturalMortalityDevParaLambda(iL2);
          }
        }
      }
      cout<<"Time-varying natural mortality deviation likelihood:"<<MnNaturalMortalityDevLikely<<endl;
      ofvTotal+=MnNaturalMortalityDevLikely;

      ////////////////////////////////// Prior probability for parameters if Bayesain is used
      MnFleetSelLikely=0.0;
      for( i=1;i<=DiFleetSelParaNum;i++)
      {
            if(active(PbnvFleetSelPara(i)))
            {
                MnFleetSelLikely+=CalLikelihoodVar(DvFleetSelParaMean(i),DvFleetSelParaSigma2(i),PbnvFleetSelPara(i), DivFleetSelParaLikelihoodFlag(i))*DvFleetSelParaLambda(i);              
            }
      }
      PriorTotal+=MnFleetSelLikely;
      
      MnFishingMortalityLikely=0.0;
      lL1=DiCalBeginYear;
      lL2=DiCalBeginYear+DiFishingMortalityParaNum-1;
      for(i=lL1;i<=lL2;i++)
      {  
              if(active(PbnvFishingMortalityPara(i)))
              {
                  MnFishingMortalityLikely+=CalLikelihoodVar(DvFishingMortalityParaMean(i),DvFishingMortalityParaSigma2(i),PbnvFishingMortalityPara(i),DivFishingMortalityParaLikelihoodFlag(i))*DvFishingMortalityParaLambda(i);
              }
      }
      PriorTotal+=MnFishingMortalityLikely;

      MnIndexSelLikely=0.0;
      for(i=1;i<=DiIndexSelParaNum;i++)
      {
             if(active(PbnvIndexSelPara(i)))
             {
                MnIndexSelLikely+=CalLikelihoodVar(DvIndexSelParaMean(i),DvIndexSelParaSigma2(i),PbnvIndexSelPara(i),DivIndexSelParaLikelihoodFlag(i))*DvIndexSelParaLambda(i);
             }
      }
      PriorTotal+=MnIndexSelLikely;     
      
      MnIndexQLikely=0.0;
      for(i=1;i<=DiIndexQBlockNum;i++)
      {
            if(active(PbnvIndexQPara(i)))
            {
              MnIndexQLikely+=CalLikelihoodVar(DvIndexQParaMean(i),DvIndexQParaSigma2(i),PbnvIndexQPara(i),DivIndexQParaLikelihoodFlag(i))*DvIndexQParaLambda(i);
            }
      }
      PriorTotal+=MnIndexQLikely;
        
      MnNYear1Likely=0.0;
      for(i=1;i<=DiNYear1ParaNum;i++)
      {
          if(active(PbnvNYear1Para(i)))
          {  
              MnNYear1Likely+=CalLikelihoodVar(DvNYear1ParaMean(i),DvNYear1ParaSigma2(i),PbnvNYear1Para(i),DivNYear1ParaLikelihoodFlag(i))*DvNYear1ParaLambda(i);
          }
      }
      PriorTotal+=MnNYear1Likely;
        
      MnRecruitParaLikely=0.0; 
      for(i=1;i<=DiRecruitParaNum;i++)
      {
          if(active(PbnvRecruitPara(i)))
          {
              MnRecruitParaLikely+= CalLikelihoodVar(DvRecruitParaMean(i),DvRecruitParaSigma2(i),PbnvRecruitPara(i),DivRecruitParaLikelihoodFlag(i))*DvRecruitParaLambda(i);
          }
      }
      PriorTotal+=MnRecruitParaLikely;

      MnRDevSDLikely=0.0;
      if(active(PbnRecruitDevSDPara))
      {
            MnRDevSDLikely=CalLikelihoodVar(DnRecruitDevSDParaMean,DnRecruitDevSDParaSigma2,PbnRecruitDevSDPara,DiRecruitDevSDParaLikelihoodFlag)*DnRecruitDevSDParaLambda;
      }       
      PriorTotal+=MnRDevSDLikely;

      MnRecruitEnvParaLikely=0.0;
      if(DiFlagRecruitEnv>0)
      {
        for(i=1;i<=DiRecruitEnvParaNum;i++)
        {
          if(active(PbnvRecruitEnvPara(i)))
          {
              MnRecruitEnvParaLikely+= CalLikelihoodVar(DvRecruitEnvParaMean(i),DvRecruitEnvParaSigma2(i),PbnvRecruitEnvPara(i),DivRecruitEnvParaLikelihoodFlag(i))*DvRecruitEnvParaLambda(i);
          }
        }
      }
      PriorTotal+=MnRecruitEnvParaLikely;
      
      MnNaturalMortalityLikely=0.0;
      if(DiNaturalMortalityFlag>0)
      {   
            for(i=1;i<=DiSeasonNum;i++)
            {
                if(active(PbnvNaturalMortalityPara(i)))
                {
                    MnNaturalMortalityLikely+=CalLikelihoodVar(DvNaturalMortalityParaMean(i),DvNaturalMortalityParaSigma2(i),PbnvNaturalMortalityPara(i),DivNaturalMortalityParaLikelihoodFlag(i))*DvNaturalMortalityParaLambda(i);
                }
            }
      }
      PriorTotal+=MnNaturalMortalityLikely;

      MnMDevSDLikely=0.0;
      if(DiNaturalMortalityFlag>1)
      {
        for (i=1;i<=DiNaturalMortalityDevSDParaNum;i++)
        {
            if(active(PbnvNaturalMortalityDevSDPara(i)))
            {
                MnMDevSDLikely=CalLikelihoodVar(DvNaturalMortalityDevSDParaMean(i),DvNaturalMortalityDevSDParaSigma2(i),PbnvNaturalMortalityDevSDPara(i),DivNaturalMortalityDevSDParaLikelihoodFlag(i))*DvNaturalMortalityDevSDParaLambda(i);
            }
        }
      }       
      PriorTotal+=MnMDevSDLikely;

      MnNaturalMortalityEnvParaLikely=0.0;
      if(DiFlagNaturalMortalityEnv>0 && DiNaturalMortalityFlag==3)
      {
        for(i=1;i<=DiNaturalMortalityEnvParaNum;i++)
        {
          if(active(PbnvNaturalMortalityEnvPara(i)))
          {
              MnNaturalMortalityEnvParaLikely+= CalLikelihoodVar(DvNaturalMortalityEnvParaMean(i),DvNaturalMortalityEnvParaSigma2(i),PbnvNaturalMortalityEnvPara(i),DivNaturalMortalityEnvParaLikelihoodFlag(i))*DvNaturalMortalityEnvParaLambda(i);
          }
        }
      }
      PriorTotal+=MnNaturalMortalityEnvParaLikely;

      MnGrowthLikely=0.0;
      if(DiGrowthMatrixFlag>0)
      {                
          for(i=1;i<=DiGrowthParaNum;i++)
          {             
              if(active(PbnvGrowthPara(i)))
              {
                  MnGrowthLikely+=CalLikelihoodVar(DvGrowthParaMean(i),DvGrowthParaSigma2(i),PbnvGrowthPara(i),DivGrowthParaLikelihoodFlag(i))*DvGrowthParaLambda(i);
              }
          }
      }
      PriorTotal+= MnGrowthLikely;

      MnGrowthDevSDLikely=0.0;
      if(DiGrowthMatrixFlag>1)
      {                
          for(i=1;i<=DiGrowthDevSDParaNum;i++)
          {             
              if(active(PbnvGrowthDevSDPara(i)))
              {
                  MnGrowthDevSDLikely+=CalLikelihoodVar(DvGrowthDevSDParaMean(i),DvGrowthDevSDParaSigma2(i),PbnvGrowthDevSDPara(i),DivGrowthDevSDParaLikelihoodFlag(i))*DvGrowthDevSDParaLambda(i);
              }
          }
      }
      PriorTotal+= MnGrowthDevSDLikely;

      MnRecruitSizePropLikely=0.0;                  
      for(i=1;i<=DiRecruitSizeBinNum;i++)
      {
          if(active(PbnvRecruitSizePropPara(i)))
          {
              MnRecruitSizePropLikely+=CalLikelihoodVar(DvRecruitSizePropParaMean(i),DvRecruitSizePropParaSigma2(i),PbnvRecruitSizePropPara(i),DivRecruitSizePropParaLikelihoodFlag(i))*DvRecruitSizePropParaLambda(i); 
          }
      }
      PriorTotal+=MnRecruitSizePropLikely;
      cout<<"Total Prior Probability:"<<PriorTotal<<endl;
      ofvTotal+= PriorTotal;

      //// FMax
      MnFMaxPenaltyLikely=0.0;
      for (i=1;i<=DiFleetNum;i++)
      {
         for(k=1;k<=DiSeasonNum;k++)
         {
            for (j=DiCalBeginYear;j<=DiCalEndYear;j++)
            {
               MnTemp1=Md3Ft(i,k,j);
               if(MnTemp1>DnFmax)
                    MnFMaxPenaltyLikely+=1000.*(MnTemp1-DnFmax)*(MnTemp1-DnFmax);
            }
         }  
      }
     
     cout<<"Penalty:"<<MnFMaxPenaltyLikely<<endl;
    
     ofvTotal+= MnFMaxPenaltyLikely;        
     cout<<"Objective Function Value:"<< ofvTotal<<endl;
     //exit(70);
     return;


FUNCTION CalNaturalMortality
    Md3M.initialize();
    MmBaseM.initialize();
    MmBaseMYrScal.initialize();
    MmMDev.initialize();

    if(DiNaturalMortalityFlag==0)
    {
       for(i=1;i<=DiSeasonNum;i++)
       {
         for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
         {
               for(k=1;k<=DiSizeBinNum;k++)
               {
                     iL1=(i-1)*DiCalYearNum+j;
                     Md3M(i,j,k)=DmNaturalMAtSize_Ini(iL1,k+2);
               }
          }
       }       
    }
    if(DiNaturalMortalityFlag==1)
    {
      for(i=1;i<=DiSeasonNum;i++)
      {                   
          for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
          {
               MmBaseM(i,j)=PbnvNaturalMortalityPara(i);
          }
      }            
      for(i=1;i<=DiSeasonNum;i++)
      {                   
          for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
          {
               for(k=1;k<=DiSizeBinNum;k++)
               {
                     Md3M(i,j,k)=MmBaseM(i,j)*DvNaturalMSizeWeight(k)*DmNaturalMYearWeight(i,j);
               }               
               MmBaseMYrScal(i,j)=MmBaseM(i,j)*DmNaturalMYearWeight(i,j);
          }
      }
    }
    if(DiNaturalMortalityFlag==2)   //random walk M
    {            
      for(i=1;i<=DiSeasonNum;i++)
      {
        for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
        {
          iL1=(i-1)*DiCalYearNum+j;
          MmMDev(i,j)=PbnvNaturalMortalityDevPara(iL1);
        }
      }
      
      for(i=1;i<=DiSeasonNum;i++)
      {         
          MmBaseM(i,1)=PbnvNaturalMortalityPara(i);         
          for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
          {
            if(j>DiCalBeginYear)
            {
               MmBaseM(i,j)=MmBaseM(i,j-1)*mfexp(MmMDev(i,j));
            }
          }
      }
      for(i=1;i<=DiSeasonNum;i++)
      {         
          for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
          {
               for(k=1;k<=DiSizeBinNum;k++)
               {
                     Md3M(i,j,k)=MmBaseM(i,j)*DvNaturalMSizeWeight(k)*DmNaturalMYearWeight(i,j);
               }               
               MmBaseMYrScal(i,j)=MmBaseM(i,j)*DmNaturalMYearWeight(i,j);
          }
      }
    }    
    if(DiNaturalMortalityFlag==3)   //avg M with random deviation
    {            
      for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
      {
        MmMDev(1,j)=PbnvNaturalMortalityDevParaSea1(j);
        MmMDev(2,j)=PbnvNaturalMortalityDevParaSea2(j);
      }
      for(i=1;i<=DiSeasonNum;i++)
      {         
          for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
          {
               MmBaseM(i,j)=PbnvNaturalMortalityPara(i)*mfexp(MmMDev(i,j));
          }
      }
      for(i=1;i<=DiSeasonNum;i++)
      {         
          for(j=DiCalBeginYear;j<=DiCalEndYear;j++)
          {
               for(k=1;k<=DiSizeBinNum;k++)
               {
                     Md3M(i,j,k)=MmBaseM(i,j)*DvNaturalMSizeWeight(k)*DmNaturalMYearWeight(i,j);
               }
               MmBaseMYrScal(i,j)=MmBaseM(i,j)*DmNaturalMYearWeight(i,j);
          }
      }
    }    
    return;

FUNCTION void GetBRPSel(int iBRPSelYear)
    int i,k;
    dvariable   dvSelMax;

    if(DiBRPSelectivityFlag==-1)
    {
      for(k=1;k<=DiSeasonNum;k++)
          MmBRPSel(k)=DmBRPSelectivityIni(k);
    }
    
    if(DiBRPSelectivityFlag==0)
    {
         for(k=1;k<=DiSeasonNum;k++)
         {
           for(i=1;i<=DiFleetNum;i++)
           {   
              MmBRPSel(k)+=Md4SelByFleet(i,k,iBRPSelYear);
           }
           MmBRPSel(k)/=DiFleetNum;
           dvSelMax=max(MmBRPSel(k));          
           if(dvSelMax>MINPOSITIVE)
                 MmBRPSel(k)= MmBRPSel(k)/dvSelMax;
         }
    }
    
    if(DiBRPSelectivityFlag>=1 && DiBRPSelectivityFlag<=DiFleetNum)
    {
          for(k=1;k<=DiSeasonNum;k++)
          {
              MmBRPSel(k)=Md4SelByFleet(DiBRPSelectivityFlag,k,iBRPSelYear);
          }
    }
    return;

////SPR and YPR are mtons per 1000 recruits for numerical convienence because
////The model units are 1000s fish or mton, the SR function R unit is 1000s fish
////If SPR or YPR values are too small, much smaller than the pre-set Finterval, the optimize (bisection) may not be able to find a solution
FUNCTION dvariable SPRFunc(const dvariable &dvFtot,int iBRPSelYear,int iBRPBioYear,int iModelFlag) 
    dvariable   dvR;    
    dvariable   dvF;
    dvariable   dvRTemp;
    double      dR;
    int         k,i,iL1;
    dvR.initialize();
    dvRTemp.initialize();
    MvBRPNAS.initialize();
    dR=1.0;                 //unit recruitment because we assume the balance was reached!
   
    MmBRPSel.initialize();
    GetBRPSel(iBRPSelYear);

    for(k=1;k<=DiSeasonNum;k++)
    {
       dvF=dvFtot*DvFRInSeason(k);
       MmBRPF(k)=dvF*MmBRPSel(k);

       MmBRPZ(k)=MmBRPF(k)+Md3M(k,iBRPBioYear);
       MmBRPS(k)=mfexp(-MmBRPZ(k));

       if(k==DiSSBSeason)
           MvBRPSSB_S=mfexp(-MmBRPZ(k)*DnFracSeasonSSB);
    } 

    for(i=1;i<=DiBRPPeriod;i++)
    {
      for(k=1;k<=DiSeasonNum;k++)
      {
          if(iModelFlag==1)      //start with one cohort and project popn until equilibrium;then get ssb and yield the equi popn can contriubte
          {
                   MvBRPNAS+= dR*DvRecruitmentSeaProp(k)*MvRecruitSizeProp;
          }

          if(iModelFlag==0)
          {                      //follow one cohort through years to get the ssb and yield it can contribute; these two methods should give the same answer
               if(i==1)
                    MvBRPNAS+= dR*DvRecruitmentSeaProp(k)*MvRecruitSizeProp;
               
               if(k==DiSSBSeason)
               {                               
                   dvRTemp=elem_prod(elem_prod(elem_prod(MvBRPNAS,MvBRPSSB_S),DmMaturityAtSize(iBRPBioYear)),DmWeightAtSize_MtPer1000Fish(iBRPBioYear))*DmFemalePropAtSize(iBRPBioYear);   //biomass                                       
                   ////dvRTemp=elem_prod(elem_prod(MvBRPNAS,MvBRPSSB_S),DmMaturityAtSize(iBRPBioYear))*DmFemalePropAtSize(iBRPBioYear);       //number                             
                   dvR +=dvRTemp;
               }
          }
          
          iL2=DimGrowthMatrixBlockFlag(iBRPBioYear,k+1);
          iL1=(iL2-1)*DiSeasonNum+k;         
          MvBRPNAS=elem_prod(MvBRPNAS,MmBRPS(k))*Md3GrowthMatrix(iL1);           //Growth 
      }
    }
    
    if(iModelFlag==1)
    {
       for(k=1;k<=DiSeasonNum;k++)
       {
           MvBRPNAS+= dR*DvRecruitmentSeaProp(k)*MvRecruitSizeProp;

           if(k==DiSSBSeason)
           {
                dvR=elem_prod(elem_prod(elem_prod(MvBRPNAS,MvBRPSSB_S),DmMaturityAtSize(DiBRPBioYear)),DmWeightAtSize_MtPer1000Fish(DiBRPBioYear))*DmFemalePropAtSize(DiBRPBioYear);   //biomass        
                ////dvR=elem_prod(elem_prod(MvBRPNAS,MvBRPSSB_S),DmMaturityAtSize(DiBRPBioYear))*DmFemalePropAtSize(DiBRPBioYear);    //number
           }
                    
          iL2=DimGrowthMatrixBlockFlag(iBRPBioYear,k+1);
          iL1=(iL2-1)*DiSeasonNum+k;
          MvBRPNAS=elem_prod(MvBRPNAS,MmBRPS(k))*Md3GrowthMatrix(iL1);
       }
    }    
    return dvR;


FUNCTION dvariable YPRFunc(const dvariable &dvFtot,int iBRPSelYear,int iBRPBioYear,int iModelFlag)  
    dvariable   dvR;    
    dvariable   dvF;
    dvariable   dvRTemp;
    double      dR;
    int         k,i,iL1;
    dvR.initialize();
    dvRTemp.initialize();
    MvBRPNAS.initialize();
    dR=1.0;                 //unit recruitment because we assume the balance was reached!
   
    MmBRPSel.initialize();
    GetBRPSel(iBRPSelYear);

    for(k=1;k<=DiSeasonNum;k++)
    {
       dvF=dvFtot*DvFRInSeason(k);
       MmBRPF(k)=dvF*MmBRPSel(k);

       MmBRPZ(k)=MmBRPF(k)+Md3M(k,iBRPBioYear);
       MmBRPS(k)=mfexp(-MmBRPZ(k));
    } 

    for(i=1;i<=DiBRPPeriod;i++)
    {
      for(k=1;k<=DiSeasonNum;k++)
      {
          if(iModelFlag==1)      //start with one cohort and project popn until equilibrium;then get ssb and yield the equi popn can contriubte
          {
                   MvBRPNAS+= dR*DvRecruitmentSeaProp(k)*MvRecruitSizeProp;
          }

          if(iModelFlag==0)
          {                      //follow one cohort through years to get the ssb and yield it can contribute; these two methods should give the same answer
               if(i==1)
                    MvBRPNAS+= dR*DvRecruitmentSeaProp(k)*MvRecruitSizeProp;
                              
               dvRTemp=elem_prod(elem_div(MmBRPF(k),MmBRPZ(k)),elem_prod(MvBRPNAS,1.0-MmBRPS(k)))*DmWeightAtSize_MtPer1000Fish(iBRPBioYear);               
               dvR +=dvRTemp;
          }
          
          iL2=DimGrowthMatrixBlockFlag(iBRPBioYear,k+1);
          iL1=(iL2-1)*DiSeasonNum+k;         
          MvBRPNAS=elem_prod(MvBRPNAS,MmBRPS(k))*Md3GrowthMatrix(iL1);           //Growth 
      }
    }
    
    if(iModelFlag==1)
    {
       for(k=1;k<=DiSeasonNum;k++)
       {
           MvBRPNAS+= dR*DvRecruitmentSeaProp(k)*MvRecruitSizeProp;

           dvR=elem_prod(elem_div(MmBRPF(k),MmBRPZ(k)),elem_prod(MvBRPNAS,1.0-MmBRPS(k)))*DmWeightAtSize_MtPer1000Fish(DiBRPBioYear);
           //ofRuntimelog<<MnBRPYield*2062<<endl;          
                    
          iL2=DimGrowthMatrixBlockFlag(iBRPBioYear,k+1);
          iL1=(iL2-1)*DiSeasonNum+k;
          MvBRPNAS=elem_prod(MvBRPNAS,MmBRPS(k))*Md3GrowthMatrix(iL1);
       }
    }    
    return dvR;

FUNCTION  dvariable EquiSSBFun(const dvariable &dvSPR,int iRS)   //equilibrium SSB
    dvariable dvR,nAlpha,nBeta;
    dvR=0.0;
  
    switch(iRS)
    {
       case 1:            
              nAlpha=PbnvRecruitPara(1);
              dvR=nAlpha*dvSPR;             //SPR needs to times 1000 if in mt per recruit because R in SR model is in thousands                   
              break;
       case 2:
              nAlpha=PbnvRecruitPara(1);
              nBeta=PbnvRecruitPara(2);
              dvR=(nAlpha*dvSPR-1)/nBeta; 
              break;
       case 3:
              nAlpha=PbnvRecruitPara(1);
              nBeta=PbnvRecruitPara(2);
              dvR=(log(nAlpha)+log(dvSPR))/nBeta;
              break;
    } 
    return dvR;

FUNCTION dvariable SPRBisection(const dvariable &dF1,const dvariable &dF2,double dInterval,double dTarget,int iBRPSelYear,int iBRPBioYear,int iStep)
    dvariable  x1,x2,f1,f2,fmid,xmid,rtb;
    int j;

    x1=SPRFunc(dF1,iBRPSelYear,iBRPBioYear,DiBRPModelFlag)/SPRFunc(0.0,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    x1 -=dTarget;
    x2=SPRFunc(dF2,iBRPSelYear,iBRPBioYear,DiBRPModelFlag)/SPRFunc(0.0,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    x2 -=dTarget;

    if(fabs(x1)<DIGITALPREC)
        return dF1;   
    if(fabs(x2)<DIGITALPREC)
        return dF2;
    
    if (x1*x2 > 0.0)
    {
          //ofRuntimelog<<"Root must be bracketed for bisection in rtbis of SPRatio"<<endl;
          cout<<"Root does not exist within the given range!"<<endl;
          return -999;
    }
    else
    {
           f1=dF1;
           f2=dF2;
           for(j=1;j<=iStep;j++)
           {                          
             fmid=(f1+f2)/2;
             xmid=SPRFunc(fmid,iBRPSelYear,iBRPBioYear,DiBRPModelFlag)/SPRFunc(0.0,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
             xmid -=dTarget;

             if(fabs(xmid)<DIGITALPREC)
             {
                 rtb=fmid;
                 return rtb;
             }

             if(fabs(f1-f2)<dInterval)
             {
                  rtb=fmid;
                  return rtb;
             }                  

             if(xmid*x2<0.0)
             {
                   f1=fmid;
                   x1=xmid;
             }
             else
             {
                   f2=fmid;
                   x2=xmid;
             }          
           }
           //ofRuntimelog<<"Too many bisections in rtbis"<<endl;
    }
    return 0.0;

FUNCTION dvariable YPRBisection(const dvariable &dF1,const dvariable &dF2,double dInterval,double dTarget,int iBRPSelYear,int iBRPBioYear,int iStep)
    dvariable  x1,x2,f1,f2,fmid,xmid,rtb,dS1,dS2,dSlopeTarget,dSlopeOrigin;
    double     dDelta;
    int j;
    
    dDelta=5e-03;

    dS1=YPRFunc(0.0,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dS2=YPRFunc(0.0+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dSlopeOrigin=(dS2-dS1)/dDelta;
    dSlopeTarget=dSlopeOrigin*dTarget;
    
    dS1=YPRFunc(dF1,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dS2=YPRFunc(dF1+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    x1=(dS2-dS1)/dDelta;
    x1 -=dSlopeTarget;

    dS1=YPRFunc(dF2,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dS2=YPRFunc(dF2+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    x2=(dS2-dS1)/dDelta;
    x2 -=dSlopeTarget;

    if(fabs(x1)<DIGITALPREC)
        return dF1;   
    if(fabs(x2)<DIGITALPREC)
        return dF2;
    
    if (x1*x2 > 0.0)
    {
          //ofRuntimelog<<"Root must be bracketed for bisection in rtbis of SPRatio"<<endl;
          cout<<"Root does not exist within the given range!"<<endl;
          return -999;
    }
    else
    {
           f1=dF1;
           f2=dF2;
           for(j=1;j<=iStep;j++)
           {                          
             fmid=(f1+f2)/2;
             dS1=YPRFunc(fmid,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
             dS2=YPRFunc(fmid+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
             xmid=(dS2-dS1)/dDelta;
             xmid -=dSlopeTarget;

             if(fabs(xmid)<DIGITALPREC)
             {
                 rtb=fmid;
                 return rtb;
             }

             if(fabs(f1-f2)<dInterval)
             {
                  rtb=fmid;
                  return rtb;
             }                  

             if(xmid*x2<0.0)
             {
                   f1=fmid;
                   x1=xmid;
             }
             else
             {
                   f2=fmid;
                   x2=xmid;
             }          
           }
           //ofRuntimelog<<"Too many bisections in rtbis"<<endl;
    }
    return 0.0;

FUNCTION dvariable MSYBisection(const dvariable &dF1,const dvariable &dF2,double dInterval,double dTarget,int iBRPSelYear,int iBRPBioYear,int iStep,int iRSFlag)
    dvariable  x1,x2,f1,f2,fmid,xmid,rtb,dS1,dS2,dSTemp,dSTemp2;
    double     dDelta;
    int j;
    
    dDelta=5e-03;
    
    dSTemp=SPRFunc(dF1,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dSTemp2=EquiSSBFun(dSTemp,iRSFlag);
    dSTemp2 /=dSTemp;
    dS1=YPRFunc(dF1,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dS1 *=dSTemp2;

    dSTemp=SPRFunc(dF1+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dSTemp2=EquiSSBFun(dSTemp,iRSFlag);
    dSTemp2 /=dSTemp;
    dS2=YPRFunc(dF1+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dS2 *=dSTemp2;

    x1=(dS2-dS1)/dDelta;
    x1 -=dTarget;

    dSTemp=SPRFunc(dF2,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dSTemp2=EquiSSBFun(dSTemp,iRSFlag);
    dSTemp2 /=dSTemp;
    dS1=YPRFunc(dF2,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dS1 *=dSTemp2;

    dSTemp=SPRFunc(dF2+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dSTemp2=EquiSSBFun(dSTemp,iRSFlag);
    dSTemp2 /=dSTemp;
    dS2=YPRFunc(dF2+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
    dS2 *=dSTemp2;

    x2=(dS2-dS1)/dDelta;
    x2 -=dTarget;

    if(fabs(x1)<DIGITALPREC)
        return dF1;   
    if(fabs(x2)<DIGITALPREC)
        return dF2;
    
    if (x1*x2 > 0.0)
    {
          //ofRuntimelog<<"Root must be bracketed for bisection in rtbis of SPRatio"<<endl;
          cout<<"Root does not exist within the given range!"<<endl;
          return -999;
    }
    else
    {
           f1=dF1;
           f2=dF2;
           for(j=1;j<=iStep;j++)
           {                          
             fmid=(f1+f2)/2;
             dSTemp=SPRFunc(fmid,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
             dSTemp2=EquiSSBFun(dSTemp,iRSFlag);
             dSTemp2 /=dSTemp;
             dS1=YPRFunc(fmid,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
             dS1 *=dSTemp2;

             dSTemp=SPRFunc(fmid+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
             dSTemp2=EquiSSBFun(dSTemp,iRSFlag);
             dSTemp2 /=dSTemp;
             dS2=YPRFunc(fmid+dDelta,iBRPSelYear,iBRPBioYear,DiBRPModelFlag);
             dS2 *=dSTemp2;
             
             xmid=(dS2-dS1)/dDelta;
             xmid -=dTarget;

             if(fabs(xmid)<DIGITALPREC)
             {
                 rtb=fmid;
                 return rtb;
             }

             if(fabs(f1-f2)<dInterval)
             {
                  rtb=fmid;
                  return rtb;
             }                  

             if(xmid*x2<0.0)
             {
                   f1=fmid;
                   x1=xmid;
             }
             else
             {
                   f2=fmid;
                   x2=xmid;
             }          
           }
           //ofRuntimelog<<"Too many bisections in rtbis"<<endl;
    }
    return 0.0;

FUNCTION CalBRPSPRatio    
    int         kk;
    double      dFinterval,DiStep;
    dvariable   dFMin,dFMax,dvTemp;
    
    dFinterval=5e-03;
    dFMin=0.0;
    dFMax=DnFmax;
    DiStep=20;
    
    MvBRPSPR.initialize();
    MvBRPSPRF0.initialize();
    MvBRPSPRatio.initialize();

    ////calculate annual SPRatio
    for(kk=DiCalBeginYear;kk<=DiCalEndYear;kk++)
    {
        MvBRPSPR(kk)=SPRFunc(sdr_vAnnualF(kk),kk,kk,DiBRPModelFlag);
        MvBRPSPRF0(kk)=SPRFunc(0.0,kk,kk,DiBRPModelFlag);
        MvBRPSPRatio(kk)=MvBRPSPR(kk)/MvBRPSPRF0(kk);
    }
    
    ////calculate Fspr
    MnBRPFThreshSPR=SPRBisection(dFMin,dFMax,dFinterval,ThreshSPR,DiBRPSelYear,DiBRPBioYear,DiStep); //search Fspr thresh
    cout<<"F"<<ThreshSPR*100<<"%:"<<MnBRPFThreshSPR<<endl;
    MnBRPFTargetSPR=SPRBisection(dFMin,dFMax,dFinterval,TargetSPR,DiBRPSelYear,DiBRPBioYear,DiStep); //search Fspr target
    cout<<"F"<<TargetSPR*100<<"%:"<<MnBRPFTargetSPR<<endl;
    
    ////calculate SSBspr
    ////EquiSSBFun(const dvariable &dvSPR,int iRS)
    if(MnBRPFThreshSPR==-999)     //Fthresh does not exist
    {
        MnBRPSSBThreshSPR=-999;
    }
    else
    {
        dvTemp=SPRFunc(MnBRPFThreshSPR,DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag);
        MnBRPSSBThreshSPR=EquiSSBFun(dvTemp,DiRSFlag);
    }
    cout<<"SSB"<<ThreshSPR*100<<"%:"<<MnBRPSSBThreshSPR<<endl;
    
    if(MnBRPFTargetSPR==-999)         ////Ftarget does not exist
    {
        MnBRPSSBTargetSPR=-999;        
    }
    else
    {
        dvTemp=SPRFunc(MnBRPFTargetSPR,DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag);
        MnBRPSSBTargetSPR=EquiSSBFun(dvTemp,DiRSFlag);
    }
    cout<<"SSB"<<TargetSPR*100<<"%:"<<MnBRPSSBTargetSPR<<endl;
    return;

FUNCTION CalBRPYPRAndMSY    
    int         FNum,kk;
    double      dFinterval,DiStep,dFStep;
    dvariable   dFMin,dFMax,dvTemp,dvTemp2;
    double      dFMin2,dFMax2;
    
    dFStep=0.1;            //interval for YPR plot output
    dFMin2=0.0;
    dFMax2=DnFmax;
    FNum=int((dFMax2-dFMin2)/dFStep+1);      //total number of Fs for calculating YPR

    dFinterval=5e-03;
    dFMin=0.0;
    dFMax=DnFmax;
    DiStep=20;

    ////calculate YPR for a vector of series F values
    MvBRPYPR.initialize();
    MvBRPYield.initialize();
    MvBRPYPRF.initialize();
    MvBRPSPRatioSeires.initialize();
    MvBRPYPRF(1)=dFMin;

    for(kk=1;kk<=(FNum-1);kk++)
    {
        MvBRPYPRF(kk+1)=MvBRPYPRF(kk)+dFStep;
    }

    for(kk=1;kk<=FNum;kk++)
    {      
        MvBRPYPR(kk)=YPRFunc(MvBRPYPRF(kk),DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag);
        dvTemp=SPRFunc(MvBRPYPRF(kk),DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag);
        dvTemp2=EquiSSBFun(dvTemp,DiRSFlag);
        dvTemp2 /=dvTemp;
        MvBRPYield(kk)=MvBRPYPR(kk)*dvTemp2;
        MvBRPSPRatioSeires(kk)=SPRFunc(MvBRPYPRF(kk),DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag)/SPRFunc(0.0,DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag);
    }
    
    ////calculate Fmax and F01
    MnBRPF01=YPRBisection(dFMin,dFMax,dFinterval,0.1,DiBRPSelYear,DiBRPBioYear,DiStep); //search F0.1
    cout<<"F"<<"0.1:"<<MnBRPF01<<endl;
    MnBRPFmax=YPRBisection(dFMin,dFMax,dFinterval,0.0,DiBRPSelYear,DiBRPBioYear,DiStep); //search Fmax
    cout<<"F"<<"max:"<<MnBRPFmax<<endl;
    
    ////calculate SSB corresponding to Fmax and F01
    ////EquiSSBFun(const dvariable &dvSPR,int iRS)
    if(MnBRPF01==-999)            //F01 does not exist
    {
        MnBRPSSBF01=-999;
    }
    else
    {
        dvTemp=SPRFunc(MnBRPF01,DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag);
        MnBRPSSBF01=EquiSSBFun(dvTemp,DiRSFlag);
    }    
    cout<<"SSB"<<"F01:"<<MnBRPSSBF01<<endl;

    if(MnBRPFmax==-999)            //Fmax does not exist
    {
        MnBRPSSBFmax=-999;
    }
    else
    {
        dvTemp=SPRFunc(MnBRPFmax,DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag);
        MnBRPSSBFmax=EquiSSBFun(dvTemp,DiRSFlag);
    }
    cout<<"SSB"<<"Fmax:"<<MnBRPSSBFmax<<endl;
  
    ////calculate Fmsy
    MnBRPFmsy=MSYBisection(dFMin,dFMax,dFinterval,0.0,DiBRPSelYear,DiBRPBioYear,DiStep,DiRSFlag); //search Fmsy
    cout<<"F"<<"msy:"<<MnBRPFmsy<<endl;
    
    ////calculate SSBmsy
    if(MnBRPFmsy==-999)            //Fmsy does not exist
    {
        MnBRPSSBFmsy=-999;
        MnBRPMSY=-999;
    }
    else
    {
        dvTemp=SPRFunc(MnBRPFmsy,DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag); 
        MnBRPSSBFmsy=EquiSSBFun(dvTemp,DiRSFlag);
        dvTemp2=YPRFunc(MnBRPFmsy,DiBRPSelYear,DiBRPBioYear,DiBRPModelFlag);
        MnBRPMSY=dvTemp2*MnBRPSSBFmsy/dvTemp;
    }
    cout<<"SSB"<<"Fmsy:"<<MnBRPSSBFmsy<<endl;
    cout<<"MSY"<<MnBRPMSY<<endl;

    return;

