 LOCAL_CALCS
   for(i=1;i<=DiIndexQBlockNum;i++)
   {
          DvIndexQParaIni(i) = DmIndexQParaData(i,1);
          DvIndexQParaLo(i) = DmIndexQParaData(i,2);
